import Submission.Schoenflies.AnnularCrosscutSeparators

/-!
# Complementary Jordan separators in a polygonal annulus

The two boundary arcs between the endpoints of a pair of disjoint annular
crosscuts give two Jordan circles with a common bridge.  This file keeps the
two circles synchronized and records the exact carrier identities needed by
the Jordan-theta region theorem.
-/

namespace Schoenflies

open Set Function
open LeanEval.Topology.ClassificationOfSurfaces.Moise

noncomputable section

namespace PolygonalCircle.AnnularCrosscut

variable {P Q : PolygonalCircle}

/-- Compatible choices of the two complementary boundary arcs on both
boundary components of an annulus. -/
structure SeparatorPair (A B : AnnularCrosscut P Q) where
  innerSplit : P.toJordanCircle.TwoBoundaryArcPaths A.innerPoint B.innerPoint
  outerSplit : Q.toJordanCircle.TwoBoundaryArcPaths A.outerPoint B.outerPoint

namespace SeparatorPair

variable {A B : AnnularCrosscut P Q} (S : SeparatorPair A B)

/-- The shared path through the first cut, one inner boundary arc, and the
reverse of the second cut. -/
def commonBridge : Path A.outerPoint B.outerPoint :=
  bridgePath A B S.innerSplit.first

/-- The first closing outer-boundary arc, oriented back to the first cut. -/
def outerArc₀ : Path B.outerPoint A.outerPoint := S.outerSplit.second

/-- The complementary closing outer-boundary arc with the same orientation. -/
def outerArc₁ : Path B.outerPoint A.outerPoint := S.outerSplit.first.symm

theorem innerFirst_range_subset :
    range S.innerSplit.first ⊆ P.carrier := by
  intro x hx
  rw [← P.carrier_toJordanCircle, ← S.innerSplit.cover]
  exact Or.inl hx

theorem innerSecond_range_subset :
    range S.innerSplit.second ⊆ P.carrier := by
  intro x hx
  rw [← P.carrier_toJordanCircle, ← S.innerSplit.cover]
  exact Or.inr hx

theorem outerArc₀_range_subset :
    range S.outerArc₀ ⊆ Q.carrier := by
  intro x hx
  rw [← Q.carrier_toJordanCircle, ← S.outerSplit.cover]
  exact Or.inr hx

theorem outerArc₁_range_subset :
    range S.outerArc₁ ⊆ Q.carrier := by
  intro x hx
  rw [← Q.carrier_toJordanCircle, ← S.outerSplit.cover]
  left
  simpa only [outerArc₁, Path.symm_range] using hx

theorem commonBridge_injective
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hAB : Disjoint (range A.path) (range B.path)) :
    Injective S.commonBridge := by
  exact bridgePath_injective hPQ A B hAB S.innerSplit.first
    S.innerSplit.first_injective S.innerFirst_range_subset

theorem commonBridge_inter_outerArc₀
    (hPQ : P.closedRegion ⊆ Q.interiorRegion) :
    range S.commonBridge ∩ range S.outerArc₀ =
      {A.outerPoint, B.outerPoint} := by
  exact range_bridgePath_inter_outerArc hPQ A B S.innerSplit.first
    S.innerFirst_range_subset S.outerArc₀ S.outerArc₀_range_subset

theorem commonBridge_inter_outerArc₁
    (hPQ : P.closedRegion ⊆ Q.interiorRegion) :
    range S.commonBridge ∩ range S.outerArc₁ =
      {A.outerPoint, B.outerPoint} := by
  exact range_bridgePath_inter_outerArc hPQ A B S.innerSplit.first
    S.innerFirst_range_subset S.outerArc₁ S.outerArc₁_range_subset

/-- The Jordan circle closed by the first complementary outer arc. -/
def circle₀
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hAB : Disjoint (range A.path) (range B.path)) : JordanCircle :=
  TwoArcJordan.toJordanCircle S.commonBridge S.outerArc₀
    (S.commonBridge_injective hPQ hAB) S.outerSplit.second_injective
    (S.commonBridge_inter_outerArc₀ hPQ)

/-- The Jordan circle closed by the second complementary outer arc. -/
def circle₁
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hAB : Disjoint (range A.path) (range B.path)) : JordanCircle :=
  TwoArcJordan.toJordanCircle S.commonBridge S.outerArc₁
    (S.commonBridge_injective hPQ hAB)
    (S.outerSplit.first_injective.comp unitInterval.symm_bijective.injective)
    (S.commonBridge_inter_outerArc₁ hPQ)

theorem carrier_circle₀
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hAB : Disjoint (range A.path) (range B.path)) :
    (S.circle₀ hPQ hAB).carrier =
      range S.commonBridge ∪ range S.outerArc₀ := by
  exact TwoArcJordan.carrier_toJordanCircle _ _ _ _ _

theorem carrier_circle₁
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hAB : Disjoint (range A.path) (range B.path)) :
    (S.circle₁ hPQ hAB).carrier =
      range S.commonBridge ∪ range S.outerArc₁ := by
  exact TwoArcJordan.carrier_toJordanCircle _ _ _ _ _

theorem outer_carrier_eq_union :
    Q.carrier = range S.outerArc₀ ∪ range S.outerArc₁ := by
  rw [← Q.carrier_toJordanCircle, ← S.outerSplit.cover]
  simp only [outerArc₀, outerArc₁, Path.symm_range, union_comm]

private theorem midpoint_mem_range_sdiff_endpoints
    {a b : Plane} (p : Path a b) (hp : Injective p) :
    p ⟨1 / 2, by norm_num⟩ ∈ range p \ {a, b} := by
  refine ⟨⟨⟨1 / 2, by norm_num⟩, rfl⟩, ?_⟩
  simp only [mem_insert_iff, mem_singleton_iff, not_or]
  constructor
  · intro h
    have ht : (⟨1 / 2, by norm_num⟩ : unitInterval) = 0 :=
      hp (h.trans p.source.symm)
    have := congrArg Subtype.val ht
    norm_num at this
  · intro h
    have ht : (⟨1 / 2, by norm_num⟩ : unitInterval) = 1 :=
      hp (h.trans p.target.symm)
    have := congrArg Subtype.val ht
    norm_num at this

theorem outerArc₀_sdiff_circle₁_nonempty
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hAB : Disjoint (range A.path) (range B.path)) :
    (range S.outerArc₀ \ (S.circle₁ hPQ hAB).carrier).Nonempty := by
  let x := S.outerArc₀ ⟨1 / 2, by norm_num⟩
  have hx := midpoint_mem_range_sdiff_endpoints S.outerArc₀
    S.outerSplit.second_injective
  refine ⟨x, hx.1, ?_⟩
  rw [S.carrier_circle₁ hPQ hAB]
  rintro (hxBridge | hxOuter)
  · have hxEnds : x ∈ ({A.outerPoint, B.outerPoint} : Set Plane) := by
      rw [← S.commonBridge_inter_outerArc₀ hPQ]
      exact ⟨hxBridge, hx.1⟩
    exact hx.2 (by
      simpa only [x, mem_insert_iff, mem_singleton_iff, or_comm]
        using hxEnds)
  · have hxEnds : x ∈ ({A.outerPoint, B.outerPoint} : Set Plane) := by
      rw [← S.outerSplit.overlap]
      refine ⟨?_, hx.1⟩
      simpa only [outerArc₁, Path.symm_range] using hxOuter
    exact hx.2 (by
      simpa only [x, mem_insert_iff, mem_singleton_iff, or_comm]
        using hxEnds)

theorem outerArc₁_sdiff_circle₀_nonempty
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hAB : Disjoint (range A.path) (range B.path)) :
    (range S.outerArc₁ \ (S.circle₀ hPQ hAB).carrier).Nonempty := by
  let x := S.outerArc₁ ⟨1 / 2, by norm_num⟩
  have hx := midpoint_mem_range_sdiff_endpoints S.outerArc₁
    (S.outerSplit.first_injective.comp unitInterval.symm_bijective.injective)
  refine ⟨x, hx.1, ?_⟩
  rw [S.carrier_circle₀ hPQ hAB]
  rintro (hxBridge | hxOuter)
  · have hxEnds : x ∈ ({A.outerPoint, B.outerPoint} : Set Plane) := by
      rw [← S.commonBridge_inter_outerArc₁ hPQ]
      exact ⟨hxBridge, hx.1⟩
    exact hx.2 (by
      simpa only [x, mem_insert_iff, mem_singleton_iff, or_comm]
        using hxEnds)
  · have hxEnds : x ∈ ({A.outerPoint, B.outerPoint} : Set Plane) := by
      rw [← S.outerSplit.overlap]
      refine ⟨?_, hxOuter⟩
      simpa only [x, outerArc₁, Path.symm_range] using hx.1
    exact hx.2 (by
      simpa only [x, mem_insert_iff, mem_singleton_iff, or_comm]
        using hxEnds)

theorem circle₀_carrier_subset_closedShell
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
  (hAB : Disjoint (range A.path) (range B.path)) :
    (S.circle₀ hPQ hAB).carrier ⊆ closedShell P Q := by
  rw [S.carrier_circle₀ hPQ hAB]
  change (range (bridgePath A B S.innerSplit.first) ∪
    range S.outerArc₀) ⊆ closedShell P Q
  rw [range_bridgePath]
  exact Set.union_subset
    (Set.union_subset
      (Set.union_subset A.range_subset_closedShell
        (S.innerFirst_range_subset.trans
          (innerCarrier_subset_closedShell P Q hPQ)))
      B.range_subset_closedShell)
    (S.outerArc₀_range_subset.trans
      (outerCarrier_subset_closedShell P Q hPQ))

theorem circle₁_carrier_subset_closedShell
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
  (hAB : Disjoint (range A.path) (range B.path)) :
    (S.circle₁ hPQ hAB).carrier ⊆ closedShell P Q := by
  rw [S.carrier_circle₁ hPQ hAB]
  change (range (bridgePath A B S.innerSplit.first) ∪
    range S.outerArc₁) ⊆ closedShell P Q
  rw [range_bridgePath]
  exact Set.union_subset
    (Set.union_subset
      (Set.union_subset A.range_subset_closedShell
        (S.innerFirst_range_subset.trans
          (innerCarrier_subset_closedShell P Q hPQ)))
      B.range_subset_closedShell)
    (S.outerArc₁_range_subset.trans
      (outerCarrier_subset_closedShell P Q hPQ))

end SeparatorPair

/-- Distinct endpoints on each boundary component admit synchronized
complementary boundary-arc choices. -/
theorem exists_separatorPair (A B : AnnularCrosscut P Q)
    (hOuterPoints : A.outerPoint ≠ B.outerPoint)
    (hInnerPoints : A.innerPoint ≠ B.innerPoint) :
    Nonempty (SeparatorPair A B) := by
  refine ⟨{
    innerSplit := Classical.choice <|
      P.toJordanCircle.exists_twoBoundaryArcPaths
        (by simpa only [P.carrier_toJordanCircle] using A.innerPoint_mem)
        (by simpa only [P.carrier_toJordanCircle] using B.innerPoint_mem)
        hInnerPoints
    outerSplit := Classical.choice <|
      Q.toJordanCircle.exists_twoBoundaryArcPaths
        (by simpa only [Q.carrier_toJordanCircle] using A.outerPoint_mem)
        (by simpa only [Q.carrier_toJordanCircle] using B.outerPoint_mem)
        hOuterPoints
  }⟩

end PolygonalCircle.AnnularCrosscut

end

end Schoenflies
