import Submission.Schoenflies.AngularSubdivisions
import Submission.Schoenflies.PlaneTopology
import Submission.ClassificationOfSurfaces.Moise.FineSubdivision
import Submission.ClassificationOfSurfaces.Moise.PolygonalPolyhedron
import Submission.Schoenflies.FiniteBoundaryGraph

/-!
# Finite polyhedral neighborhoods of Jordan subarcs

This is the compact/open part of the brick-neighborhood construction used in
Moise 9.5.  The existing `FineSubdivision` theorem supplies a finite triangle
submesh between a compact set and any prescribed open neighborhood.  The
result here specializes that theorem to the embedded boundary arcs selected by
`AngularSubdivisions`.

No assertion that the retained submesh is a disk is made here.  Filling its
bounded complementary components, and extracting the resulting outer polygon,
is precisely the remaining planar frame step.
-/

namespace Schoenflies

open Metric Set
open LeanEval.Topology.ClassificationOfSurfaces.Moise

namespace JordanCircle

variable {J : JordanCircle}

private abbrev MoisePlaneComplex :=
  LeanEval.Topology.ClassificationOfSurfaces.Moise.PlaneComplex

private abbrev MoiseTriangleMesh :=
  LeanEval.Topology.ClassificationOfSurfaces.Moise.TriangleMesh

/-- A finite polyhedral neighborhood of `C` contained in `U`.  Requiring
`C` to lie in the interior (rather than merely in the support) is the buffer
needed before bounded complementary components are filled. -/
structure FinitePolyhedralNeighborhood (C U : Set Plane) where
  mesh : MoiseTriangleMesh
  coversInterior : C ⊆ interior mesh.toPlaneComplex.support
  contained : mesh.toPlaneComplex.support ⊆ U

/-- A finite pure plane complex large enough to contain a given compact set.

The complex consists initially of one sufficiently large triangle.  Keeping
this construction local avoids adding a new global triangulation of the plane
to the Schoenflies dependency surface. -/
theorem exists_purePlaneComplex_containing_compact
    {C : Set Plane} (hC : IsCompact C) :
    ∃ K : MoisePlaneComplex, K.IsPure2 ∧ C ⊆ K.support := by
  obtain ⟨r, hr⟩ := hC.isBounded.subset_closedBall (0 : Plane)
  let R : ℝ := max r 1
  have hR : 0 < R := lt_of_lt_of_le zero_lt_one (le_max_right r 1)
  let p := PolygonalCircle.enclosingTriangleVertices R
  have hp : AffineIndependent ℝ p :=
    PolygonalCircle.enclosingTriangleVertices_affineIndependent (R := R) hR
  let M : MoiseTriangleMesh :=
    LeanEval.Topology.ClassificationOfSurfaces.Moise.TriangleMesh.single p hp
  let K : MoisePlaneComplex := M.toPlaneComplex
  refine ⟨K, M.toPlaneComplex_isPure2, ?_⟩
  have hball : closedBall (0 : Plane) R ⊆ convexHull ℝ (Set.range p) :=
    PolygonalCircle.closedBall_subset_enclosingTriangle (R := R) hR
  intro x hx
  have hxBall : x ∈ closedBall (0 : Plane) R :=
    (closedBall_subset_closedBall (le_max_left r 1)) (hr hx)
  change x ∈ M.toPlaneComplex.support
  change x ∈ (LeanEval.Topology.ClassificationOfSurfaces.Moise.TriangleMesh.single
    p hp).toPlaneComplex.support
  rw [LeanEval.Topology.ClassificationOfSurfaces.Moise.TriangleMesh.single_support]
  exact hball hxBall

/-- Every selected Jordan subarc has a finite triangulated neighborhood
contained in any prescribed ambient open neighborhood.

This is the portion of Moise's brick construction that follows solely from
compactness and fine subdivision.  The returned `OpenSubmesh` records both
coverage of the arc and containment in `U`, as well as subordination of every
retained triangle to the enclosing complex. -/
theorem AccessibleAngularArc.exists_openSubmesh
    (A : J.AccessibleAngularArc) {U : Set Plane}
    (hU : IsOpen U) (hAU : A.curveArcPlane ⊆ U) :
    ∃ K : MoisePlaneComplex,
      K.IsPure2 ∧ Nonempty (K.OpenSubmesh A.curveArcPlane U) := by
  obtain ⟨K, hKpure, hAK⟩ :=
    exists_purePlaneComplex_containing_compact A.curveArcPlane_isCompact
  exact ⟨K, hKpure,
    K.exists_openSubmesh hKpure A.curveArcPlane_isCompact hAK hU hAU⟩

/-- Compact subsets of open plane sets admit finite polyhedral neighborhoods
with an honest open buffer around the compact set.

We first insert a closed metric thickening between `C` and `U`, then ask the
existing Moise subdivision theorem to cover that larger compact set. -/
theorem exists_finitePolyhedralNeighborhood
    {C U : Set Plane} (hC : IsCompact C) (hU : IsOpen U) (hCU : C ⊆ U) :
    Nonempty (FinitePolyhedralNeighborhood C U) := by
  obtain ⟨delta, hdelta, hthickU⟩ := hC.exists_cthickening_subset_open hU hCU
  let D := cthickening delta C
  have hDcompact : IsCompact D := hC.cthickening
  obtain ⟨K, hKpure, hDK⟩ :=
    exists_purePlaneComplex_containing_compact hDcompact
  let L := Classical.choice
    (K.exists_openSubmesh hKpure hDcompact hDK hU hthickU)
  refine ⟨{
    mesh := L.mesh
    coversInterior := ?_
    contained := L.contained }⟩
  intro x hxC
  rw [mem_interior_iff_mem_nhds]
  apply Filter.mem_of_superset (ball_mem_nhds x hdelta)
  exact ball_subset_closedBall.trans
    ((closedBall_subset_cthickening hxC delta).trans L.covers)

/-- Buffered finite polyhedral neighborhood specialized to a selected Jordan
subarc. -/
theorem AccessibleAngularArc.exists_finitePolyhedralNeighborhood
    (A : J.AccessibleAngularArc) {U : Set Plane}
    (hU : IsOpen U) (hAU : A.curveArcPlane ⊆ U) :
    Nonempty (FinitePolyhedralNeighborhood A.curveArcPlane U) :=
  JordanCircle.exists_finitePolyhedralNeighborhood
    A.curveArcPlane_isCompact hU hAU

namespace FinitePolyhedralNeighborhood

/-- The connected open piece of a finite polyhedral neighborhood which
contains the selected arc.  This formalizes Moise's deletion of components
which do not meet the compact set. -/
def arcComponent {U : Set Plane} (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) : Set Plane :=
  connectedComponentIn (interior N.mesh.toPlaneComplex.support)
    (J.curvePoint A.left)

theorem curveArcPlane_subset_arcComponent {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    A.curveArcPlane ⊆ N.arcComponent A := by
  intro x hx
  exact A.curveArcPlane_isPreconnected.subset_connectedComponentIn
    A.left_mem_curveArcPlane N.coversInterior hx

theorem isOpen_arcComponent {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    IsOpen (N.arcComponent A) :=
  isOpen_interior.connectedComponentIn

theorem isConnected_arcComponent {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    IsConnected (N.arcComponent A) := by
  rw [arcComponent, isConnected_connectedComponentIn_iff]
  exact N.coversInterior A.left_mem_curveArcPlane

theorem arcComponent_subset_ambient {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    N.arcComponent A ⊆ U :=
  (connectedComponentIn_subset _ _).trans (interior_subset.trans N.contained)

/-- The closed polyhedral core selected by the component containing the arc.

Taking the closure here discards all components of the original finite
submesh which are irrelevant to the selected Jordan subarc.  This is the
topological set whose bounded complementary components are filled in
Moise's frame construction. -/
def arcFrameCore {U : Set Plane} (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) : Set Plane :=
  closure (N.arcComponent A)

theorem curveArcPlane_subset_arcFrameCore {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    A.curveArcPlane ⊆ N.arcFrameCore A :=
  (N.curveArcPlane_subset_arcComponent A).trans subset_closure

theorem arcFrameCore_subset_support {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    N.arcFrameCore A ⊆ N.mesh.toPlaneComplex.support := by
  apply closure_minimal
  · exact (connectedComponentIn_subset _ _).trans interior_subset
  · exact N.mesh.toPlaneComplex.isCompact_support.isClosed

theorem arcFrameCore_subset_ambient {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    N.arcFrameCore A ⊆ U :=
  (N.arcFrameCore_subset_support A).trans N.contained

theorem isCompact_arcFrameCore {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    IsCompact (N.arcFrameCore A) :=
  N.mesh.toPlaneComplex.isCompact_support.of_isClosed_subset
    isClosed_closure (N.arcFrameCore_subset_support A)

theorem isConnected_arcFrameCore {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    IsConnected (N.arcFrameCore A) :=
  (N.isConnected_arcComponent A).closure

theorem arcComponent_subset_interior_arcFrameCore {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    N.arcComponent A ⊆ interior (N.arcFrameCore A) := by
  intro x hx
  rw [mem_interior_iff_mem_nhds]
  exact Filter.mem_of_superset
    (N.isOpen_arcComponent A |>.mem_nhds hx) subset_closure

theorem curveArcPlane_subset_interior_arcFrameCore {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    A.curveArcPlane ⊆ interior (N.arcFrameCore A) :=
  (N.curveArcPlane_subset_arcComponent A).trans
    (N.arcComponent_subset_interior_arcFrameCore A)

/-- The selected core is regular closed.  This rules out lower-dimensional
debris: every point of the core is approached through the same open
polyhedral component. -/
theorem closure_interior_arcFrameCore {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    closure (interior (N.arcFrameCore A)) = N.arcFrameCore A := by
  apply Set.Subset.antisymm
  · exact closure_minimal interior_subset isClosed_closure
  · change closure (N.arcComponent A) ⊆ _
    exact closure_mono (N.arcComponent_subset_interior_arcFrameCore A)

/-- The triangle submesh belonging to the open component which contains the
selected Jordan arc.  A triangle is retained exactly when its Euclidean
interior meets that component.  This is the finite-complex version of Moise's
instruction to discard all bricks not belonging to the component of `A`. -/
noncomputable def componentMesh {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) : MoiseTriangleMesh := by
  classical
  exact N.mesh.restrictTriangles fun t =>
    (interior (N.mesh.triangleCarrier t) ∩ N.arcComponent A).Nonempty

@[simp] theorem mem_componentMesh_triangles_iff {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U)
    {t : Finset (N.componentMesh A).Vertex} :
    t ∈ (N.componentMesh A).triangles ↔
      t ∈ N.mesh.triangles ∧
        (interior (N.mesh.triangleCarrier t) ∩ N.arcComponent A).Nonempty := by
  classical
  change t ∈ N.mesh.triangles.filter (fun t =>
      (interior (N.mesh.triangleCarrier t) ∩ N.arcComponent A).Nonempty) ↔ _
  exact Finset.mem_filter

/-- Every retained triangle has its whole open two-cell in the selected open
component.  This is where connected-component selection eliminates all
irrelevant mesh pieces at once. -/
theorem interior_triangleCarrier_subset_arcComponent_of_mem_componentMesh
    {U : Set Plane} (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U)
    {t : Finset (N.componentMesh A).Vertex}
    (ht : t ∈ (N.componentMesh A).triangles) :
    interior ((N.componentMesh A).triangleCarrier t) ⊆ N.arcComponent A := by
  classical
  have htN : t ∈ N.mesh.triangles :=
    (N.mem_componentMesh_triangles_iff A).mp ht |>.1
  obtain ⟨y, hytri, hycomponent⟩ :=
    (N.mem_componentMesh_triangles_iff A).mp ht |>.2
  let T : N.mesh.Triangle := ⟨t, htN⟩
  have hconvex : Convex ℝ (interior (N.mesh.triangleCarrier t)) :=
    (convex_convexHull ℝ _).interior
  have hsubSupport : interior (N.mesh.triangleCarrier t) ⊆
      interior N.mesh.toPlaneComplex.support := by
    apply interior_mono
    rw [N.mesh.toPlaneComplex_support]
    exact Set.subset_iUnion_of_subset t
      (Set.subset_iUnion_of_subset htN (by rfl))
  have hsubAtY : interior (N.mesh.triangleCarrier t) ⊆
      connectedComponentIn (interior N.mesh.toPlaneComplex.support) y :=
    hconvex.isPreconnected.subset_connectedComponentIn hytri hsubSupport
  change interior (N.mesh.triangleCarrier t) ⊆
    connectedComponentIn (interior N.mesh.toPlaneComplex.support)
      (J.curvePoint A.left)
  rw [connectedComponentIn_eq hycomponent]
  exact hsubAtY

/-- The selected open component is covered by its retained closed triangles.
Points on mesh edges are handled by approaching them through the interior of
any incident triangle inside the open component. -/
theorem arcComponent_subset_componentMesh_support {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    N.arcComponent A ⊆ (N.componentMesh A).toPlaneComplex.support := by
  classical
  intro x hx
  have hxSupport : x ∈ N.mesh.toPlaneComplex.support :=
    interior_subset ((connectedComponentIn_subset _ _) hx)
  rw [N.mesh.toPlaneComplex_support] at hxSupport
  obtain ⟨t, ht, hxt⟩ := Set.mem_iUnion₂.mp hxSupport
  let T : N.mesh.Triangle := ⟨t, ht⟩
  have hxClosure : x ∈ closure (interior (N.mesh.triangleCarrier t)) := by
    rw [N.mesh.closure_interior_triangleCarrier T]
    exact hxt
  have hmeet :
      (interior (N.mesh.triangleCarrier t) ∩ N.arcComponent A).Nonempty := by
    have hnhds := (N.isOpen_arcComponent A).mem_nhds hx
    obtain ⟨y, hycomponent, hytri⟩ :=
      (_root_.mem_closure_iff.1 hxClosure) (N.arcComponent A)
        (N.isOpen_arcComponent A) hx
    exact ⟨y, hytri, hycomponent⟩
  have htSelected : t ∈ (N.componentMesh A).triangles :=
    (N.mem_componentMesh_triangles_iff A).mpr ⟨ht, hmeet⟩
  rw [(N.componentMesh A).toPlaneComplex_support]
  exact Set.mem_iUnion₂.mpr ⟨t, htSelected, hxt⟩

/-- The support of the component submesh is exactly the regular closed core.
In particular the subsequent outer-boundary argument may work with a genuine
finite triangle mesh, rather than an abstract closure of a component. -/
theorem componentMesh_support_eq_arcFrameCore {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    (N.componentMesh A).toPlaneComplex.support = N.arcFrameCore A := by
  classical
  apply Set.Subset.antisymm
  · rw [(N.componentMesh A).toPlaneComplex_support]
    intro x hx
    obtain ⟨t, ht, hxt⟩ := Set.mem_iUnion₂.mp hx
    have hinteriorSub :=
      N.interior_triangleCarrier_subset_arcComponent_of_mem_componentMesh A ht
    have hxClosure : x ∈
        closure (interior ((N.componentMesh A).triangleCarrier t)) := by
      let T : (N.componentMesh A).Triangle := ⟨t, ht⟩
      rw [(N.componentMesh A).closure_interior_triangleCarrier T]
      exact hxt
    exact closure_mono hinteriorSub hxClosure
  · apply closure_minimal (N.arcComponent_subset_componentMesh_support A)
    exact (N.componentMesh A).toPlaneComplex.isCompact_support.isClosed

/-- Restricting to the selected component does not introduce any new point of
the original finite neighborhood. -/
theorem componentMesh_support_subset_mesh_support {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    (N.componentMesh A).toPlaneComplex.support ⊆
      N.mesh.toPlaneComplex.support := by
  classical
  rw [(N.componentMesh A).toPlaneComplex_support,
    N.mesh.toPlaneComplex_support]
  intro x hx
  obtain ⟨t, ht, hxt⟩ := Set.mem_iUnion₂.mp hx
  exact Set.mem_iUnion₂.mpr
    ⟨t, (N.mem_componentMesh_triangles_iff A).mp ht |>.1, hxt⟩

/-- No extra open chamber is created when the selected triangles are closed
up: the interior of their support is precisely the original open component.
The small segment argument at a shared edge or vertex is the key point. -/
theorem interior_componentMesh_support_eq_arcComponent {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    interior (N.componentMesh A).toPlaneComplex.support = N.arcComponent A := by
  classical
  apply Set.Subset.antisymm
  · intro x hx
    have hxOriginal : x ∈ interior N.mesh.toPlaneComplex.support :=
      interior_mono (N.componentMesh_support_subset_mesh_support A) hx
    have hxSupport : x ∈ (N.componentMesh A).toPlaneComplex.support :=
      interior_subset hx
    rw [(N.componentMesh A).toPlaneComplex_support] at hxSupport
    obtain ⟨t, ht, hxt⟩ := Set.mem_iUnion₂.mp hxSupport
    let T : (N.componentMesh A).Triangle := ⟨t, ht⟩
    obtain ⟨y, hyInterior⟩ :=
      (N.componentMesh A).interior_triangleCarrier_nonempty T
    have hyComponent : y ∈ N.arcComponent A :=
      N.interior_triangleCarrier_subset_arcComponent_of_mem_componentMesh A ht
        hyInterior
    have hsegmentSubset : segment ℝ x y ⊆
        interior N.mesh.toPlaneComplex.support := by
      intro z hz
      rcases eq_or_ne z x with rfl | hzx
      · exact hxOriginal
      rcases eq_or_ne z y with rfl | hzy
      · exact (connectedComponentIn_subset _ _) hyComponent
      have hzOpen : z ∈ openSegment ℝ x y := by
        exact mem_openSegment_of_ne_left_right hzx.symm hzy.symm hz
      have hzTriangle : z ∈
          interior ((N.componentMesh A).triangleCarrier t) :=
        (convex_convexHull ℝ _).openSegment_self_interior_subset_interior
          hxt hyInterior hzOpen
      exact (connectedComponentIn_subset _ _)
        (N.interior_triangleCarrier_subset_arcComponent_of_mem_componentMesh
          A ht hzTriangle)
    have hsegToY : segment ℝ x y ⊆
        connectedComponentIn (interior N.mesh.toPlaneComplex.support) y :=
      (convex_segment x y).isPreconnected.subset_connectedComponentIn
        (right_mem_segment ℝ x y) hsegmentSubset
    change x ∈ connectedComponentIn
      (interior N.mesh.toPlaneComplex.support) (J.curvePoint A.left)
    rw [connectedComponentIn_eq hyComponent]
    exact hsegToY (left_mem_segment ℝ x y)
  · have h := N.arcComponent_subset_interior_arcFrameCore A
    rw [← N.componentMesh_support_eq_arcFrameCore A] at h
    exact h

theorem closure_interior_componentMesh_support {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    closure (interior (N.componentMesh A).toPlaneComplex.support) =
      (N.componentMesh A).toPlaneComplex.support := by
  rw [N.interior_componentMesh_support_eq_arcComponent A,
    N.componentMesh_support_eq_arcFrameCore A]
  rfl

/-- For the component-selected regular closed mesh, the incidence-one edge
carrier is the entire topological frontier.  The only possible gap in the
generic nonvertex mesh theorem is a finite set of mesh vertices; planar
punctured-ball connectivity and regular closedness remove that gap. -/
theorem componentMesh_boundaryCarrier_eq_frontier {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    (N.componentMesh A).boundaryCarrier =
      frontier (N.componentMesh A).toPlaneComplex.support := by
  let M := N.componentMesh A
  apply Set.Subset.antisymm M.boundaryCarrier_subset_frontier
  have hdense : frontier M.toPlaneComplex.support ⊆
      closure (frontier M.toPlaneComplex.support \ Set.range M.position) :=
    frontier_subset_closure_sdiff_finite_of_regularClosed
      M.toPlaneComplex.isCompact_support.isClosed
      (N.closure_interior_componentMesh_support A)
      (Set.finite_range M.position)
  have hnonvertex : frontier M.toPlaneComplex.support \ Set.range M.position ⊆
      M.boundaryCarrier := by
    rintro x ⟨hxFrontier, hxNotVertex⟩
    have hxv : ∀ v : M.Vertex, x ≠ M.position v := by
      intro v hx
      exact hxNotVertex ⟨v, hx.symm⟩
    obtain ⟨e, he, hxe⟩ :=
      (M.mem_frontier_iff_exists_boundaryEdge_of_nonvertex hxv).mp hxFrontier
    rw [TriangleMesh.boundaryCarrier]
    exact Set.mem_iUnion₂.mpr
      ⟨e, M.mem_allBoundaryEdges_iff.mpr he, hxe⟩
  exact hdense.trans <| by
    have h := closure_mono hnonvertex
    rwa [M.isCompact_boundaryCarrier.isClosed.closure_eq] at h

theorem componentMesh_triangles_nonempty {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    (N.componentMesh A).triangles.Nonempty := by
  have hxComponent : (J.curvePoint A.left : Plane) ∈ N.arcComponent A :=
    N.curveArcPlane_subset_arcComponent A A.left_mem_curveArcPlane
  have hxSupport := N.arcComponent_subset_componentMesh_support A hxComponent
  rw [(N.componentMesh A).toPlaneComplex_support] at hxSupport
  obtain ⟨t, ht, -⟩ := Set.mem_iUnion₂.mp hxSupport
  exact ⟨t, ht⟩

/-- A boundary-cycle candidate now extracted from the component mesh itself.
Unlike a cycle from the original open submesh, it cannot belong to a retained
component unrelated to the chosen Jordan arc. -/
theorem exists_componentBoundaryPolygonalCircle {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    ∃ P : PolygonalCircle,
      P.carrier ⊆ frontier (N.arcFrameCore A) ∧
        P.carrier ⊆ U ∧ Disjoint P.carrier (N.arcComponent A) := by
  obtain ⟨P, hPboundary⟩ :=
    Schoenflies.TriangleMesh.exists_polygonalCircle_carrier_subset_boundaryCarrier
      (N.componentMesh A) (N.componentMesh_triangles_nonempty A)
  have hPfrontier : P.carrier ⊆ frontier (N.arcFrameCore A) := by
    rw [← N.componentMesh_support_eq_arcFrameCore A]
    exact hPboundary.trans (N.componentMesh A).boundaryCarrier_subset_frontier
  refine ⟨P, hPfrontier, ?_, ?_⟩
  · exact hPfrontier.trans
      ((N.isCompact_arcFrameCore A).isClosed.frontier_subset.trans
        (N.arcFrameCore_subset_ambient A))
  · rw [← N.interior_componentMesh_support_eq_arcComponent A]
    exact Set.disjoint_of_subset_left hPboundary <|
      Set.disjoint_of_subset_left
        (N.componentMesh A).boundaryCarrier_subset_frontier <|
          disjoint_interior_frontier.symm

theorem mesh_triangles_nonempty {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    N.mesh.triangles.Nonempty := by
  have hx : (J.curvePoint A.left : Plane) ∈ N.mesh.toPlaneComplex.support :=
    interior_subset (N.coversInterior A.left_mem_curveArcPlane)
  rw [N.mesh.toPlaneComplex_support] at hx
  obtain ⟨t, ht, -⟩ := Set.mem_iUnion₂.mp hx
  exact ⟨t, ht⟩

/-- The finite buffered neighborhood has at least one genuine polygonal
boundary component.  Its carrier stays in the prescribed ambient open set
and is disjoint from the open component containing the selected arc.

The next frame-selection lemma must choose the *outer* such component; this
result supplies the finite polygonal candidates without assuming that the
whole mesh boundary is itself one circle. -/
theorem exists_boundaryPolygonalCircle {U : Set Plane}
    (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    ∃ P : PolygonalCircle,
      P.carrier ⊆ U ∧ Disjoint P.carrier (N.arcComponent A) := by
  obtain ⟨P, hPboundary⟩ :=
    Schoenflies.TriangleMesh.exists_polygonalCircle_carrier_subset_boundaryCarrier
      N.mesh (N.mesh_triangles_nonempty A)
  refine ⟨P, ?_, ?_⟩
  · exact hPboundary.trans
      (N.mesh.boundaryCarrier_subset_frontier.trans
        (N.mesh.toPlaneComplex.isCompact_support.isClosed.frontier_subset.trans N.contained))
  · apply Set.disjoint_of_subset_left hPboundary
    apply Set.disjoint_of_subset_left N.mesh.boundaryCarrier_subset_frontier
    apply Set.disjoint_of_subset_right
      (connectedComponentIn_subset (interior N.mesh.toPlaneComplex.support)
        (J.curvePoint A.left))
    exact disjoint_interior_frontier.symm

/-- Any polygonal boundary candidate is of exactly the geometrically useful
kind: either its closed disk contains the selected frame core (an outer
candidate), or its open disk misses the core (a hole candidate). -/
theorem arcFrameCore_subset_closedRegion_or_disjoint_interiorRegion
    {U : Set Plane} (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U)
    (P : PolygonalCircle)
    (hdis : Disjoint P.carrier (N.arcComponent A)) :
    N.arcFrameCore A ⊆ P.closedRegion ∨
      Disjoint P.interiorRegion (N.arcFrameCore A) := by
  have hcomponentCompl : N.arcComponent A ⊆ P.carrierᶜ := by
    intro x hx hxc
    exact Set.disjoint_left.mp hdis hxc hx
  have hregions : N.arcComponent A ⊆
      P.interiorRegion ∪ P.exteriorRegion := by
    rw [P.interior_union_exterior]
    exact hcomponentCompl
  rcases (N.isConnected_arcComponent A).isPreconnected.subset_or_subset
      P.isOpen_interiorRegion P.isOpen_exteriorRegion
      P.disjoint_interior_exterior hregions with hin | hout
  · exact Or.inl (by
      change closure (N.arcComponent A) ⊆ closure P.interiorRegion
      exact closure_mono hin)
  · right
    rw [Set.disjoint_left]
    intro x hxInterior hxCore
    have hxClosureExterior : x ∈ closure P.exteriorRegion :=
      closure_mono hout hxCore
    rw [closure_eq_self_union_frontier, P.frontier_exteriorRegion] at hxClosureExterior
    rcases hxClosureExterior with hxExterior | hxCarrier
    · exact Set.disjoint_left.mp P.disjoint_interior_exterior hxInterior hxExterior
    · have hxCompl : x ∈ P.carrierᶜ := by
        rw [← P.interior_union_exterior]
        exact Or.inl hxInterior
      exact hxCompl hxCarrier

/-- The component-selected mesh has an exterior-facing polygonal boundary
cycle.  Its carrier lies in the prescribed ambient neighborhood, while its
closed disk contains the entire regular-closed frame core. -/
theorem exists_outerBoundaryPolygonalCircle
    {U : Set Plane} (A : J.AccessibleAngularArc)
    (N : FinitePolyhedralNeighborhood A.curveArcPlane U) :
    ∃ P : PolygonalCircle,
      P.carrier ⊆ frontier (N.arcFrameCore A) ∧
        P.carrier ⊆ U ∧ N.arcFrameCore A ⊆ P.closedRegion := by
  let M := N.componentMesh A
  obtain ⟨P, hPboundary, x, hxInside, hxMeshInterior⟩ :=
    Schoenflies.TriangleMesh.exists_boundaryPolygonalCircle_meeting_interiorRegion
      M (N.componentMesh_triangles_nonempty A)
  have hPfrontier : P.carrier ⊆ frontier (N.arcFrameCore A) := by
    rw [← N.componentMesh_support_eq_arcFrameCore A,
      ← N.componentMesh_boundaryCarrier_eq_frontier A]
    exact hPboundary
  have hPambient : P.carrier ⊆ U :=
    hPfrontier.trans
      ((N.isCompact_arcFrameCore A).isClosed.frontier_subset.trans
        (N.arcFrameCore_subset_ambient A))
  have hPdisjoint : Disjoint P.carrier (N.arcComponent A) := by
    rw [← N.interior_componentMesh_support_eq_arcComponent A]
    exact Set.disjoint_of_subset_left hPboundary <|
      Set.disjoint_of_subset_left
        (N.componentMesh A).boundaryCarrier_subset_frontier
          disjoint_interior_frontier.symm
  have hxComponent : x ∈ N.arcComponent A := by
    rw [← N.interior_componentMesh_support_eq_arcComponent A]
    exact hxMeshInterior
  rcases N.arcFrameCore_subset_closedRegion_or_disjoint_interiorRegion
      A P hPdisjoint with hOuter | hHole
  · exact ⟨P, hPfrontier, hPambient, hOuter⟩
  · have hxCore : x ∈ N.arcFrameCore A := subset_closure hxComponent
    exact (Set.disjoint_left.mp hHole hxInside hxCore).elim

end FinitePolyhedralNeighborhood

/-- Metric form of `AccessibleAngularArc.exists_openSubmesh`, matching the
neighborhood used in the controlled-crosscut statement of Moise 9.5. -/
theorem AccessibleAngularArc.exists_openSubmesh_in_thickening
    (A : J.AccessibleAngularArc) {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ K : MoisePlaneComplex,
      K.IsPure2 ∧ Nonempty
        (K.OpenSubmesh A.curveArcPlane (thickening epsilon A.curveArcPlane)) := by
  apply A.exists_openSubmesh isOpen_thickening
  exact self_subset_thickening hepsilon _

/-- Buffered metric form used by the frame construction. -/
theorem AccessibleAngularArc.exists_finitePolyhedralNeighborhood_in_thickening
    (A : J.AccessibleAngularArc) {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    Nonempty (FinitePolyhedralNeighborhood A.curveArcPlane
      (thickening epsilon A.curveArcPlane)) := by
  apply A.exists_finitePolyhedralNeighborhood isOpen_thickening
  exact self_subset_thickening hepsilon _

end JordanCircle

