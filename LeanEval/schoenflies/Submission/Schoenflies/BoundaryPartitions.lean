/-!
# Accessible subdivisions of a Jordan circle

The density theorem from `Schoenflies.Accessibility` is stated in the ambient
plane.  This file transports it to the curve itself and packages the finite
subdivision step used in Moise Chapter 9: between two distinct marked points,
each of the two intervening open arcs contains a point accessible from either
complementary region.
-/

namespace Schoenflies

open Metric Set Function

namespace JordanCircle

variable (J : JordanCircle)

/-- Accessible-from-the-inside points, as a subset of the curve subtype. -/
def insideAccessibleCarrier : Set J.carrier :=
  {x | (x : Plane) ∈ J.insideLinearlyAccessiblePoints}

/-- Accessible-from-the-outside points, as a subset of the curve subtype. -/
def outsideAccessibleCarrier : Set J.carrier :=
  {x | (x : Plane) ∈ J.outsideLinearlyAccessiblePoints}

theorem val_image_insideAccessibleCarrier :
    ((fun x : J.carrier => (x : Plane)) '' J.insideAccessibleCarrier) =
      J.insideLinearlyAccessiblePoints := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact hy
  · intro hx
    exact ⟨⟨x, hx.1⟩, hx, rfl⟩

theorem val_image_outsideAccessibleCarrier :
    ((fun x : J.carrier => (x : Plane)) '' J.outsideAccessibleCarrier) =
      J.outsideLinearlyAccessiblePoints := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact hy
  · intro hx
    exact ⟨⟨x, hx.1⟩, hx, rfl⟩

/-- Inside-accessible points are dense in the intrinsic topology of the
Jordan circle. -/
theorem insideAccessibleCarrier_dense : Dense J.insideAccessibleCarrier := by
  rw [Subtype.dense_iff, J.val_image_insideAccessibleCarrier]
  exact J.carrier_subset_closure_insideLinearlyAccessiblePoints

/-- Outside-accessible points are dense in the intrinsic topology of the
Jordan circle. -/
theorem outsideAccessibleCarrier_dense : Dense J.outsideAccessibleCarrier := by
  rw [Subtype.dense_iff, J.val_image_outsideAccessibleCarrier]
  exact J.carrier_subset_closure_outsideLinearlyAccessiblePoints

/-- Angles whose points on the parametrized curve are accessible from the
inside.  Keeping this set on `ℝ` makes finite cyclic subdivisions concrete. -/
def insideAccessibleAngles : Set ℝ :=
  {t | J.carrierHomeomorph (JordanCurve.Arcs.param t) ∈
    J.insideAccessibleCarrier}

/-- The accessible angles are dense on the real line.  This is the form of
Moise 9.2 used to put a new marked point in any prescribed angular interval. -/
theorem insideAccessibleAngles_dense : Dense J.insideAccessibleAngles := by
  have hopen : IsOpenMap
      (fun t : ℝ => J.carrierHomeomorph (JordanCurve.Arcs.param t)) := by
    exact J.carrierHomeomorph.isOpenMap.comp
      (JordanCurve.Arcs.circleHomeoSphere.isOpenMap.comp
        isLocalHomeomorph_circleExp.isOpenMap)
  exact J.insideAccessibleCarrier_dense.preimage hopen

/-- Every nonempty angular interval contains an inside-accessible marked
point. -/
theorem exists_insideAccessibleAngle {a b : ℝ} (hab : a < b) :
    ∃ t ∈ Ioo a b, J.carrierHomeomorph (JordanCurve.Arcs.param t) ∈
      J.insideAccessibleCarrier := by
  obtain ⟨t, htD, htI⟩ := J.insideAccessibleAngles_dense.exists_mem_open
    isOpen_Ioo (nonempty_Ioo.mpr hab)
  exact ⟨t, htI, htD⟩

/-- In a two-arc decomposition of a circle, the relative interior of either
arc is the complement of the other arc. -/
private theorem arc_sdiff_endpoints_eq_compl {K : Type*} [TopologicalSpace K]
    {A B E : Set K} (hunion : A ∪ B = univ) (hinter : A ∩ B = E) :
    A \ E = Bᶜ := by
  ext z
  constructor
  · intro hz
    exact fun hzB => hz.2 (hinter ▸ ⟨hz.1, hzB⟩)
  · intro hzB
    have hzAB : z ∈ A ∨ z ∈ B := by
      have : z ∈ A ∪ B := by rw [hunion]; trivial
      exact this
    have hzA : z ∈ A := hzAB.resolve_right hzB
    refine ⟨hzA, ?_⟩
    intro hzE
    have hzInter : z ∈ A ∩ B := hinter.symm ▸ hzE
    exact hzB hzInter.2

/-- The data produced by inserting one accessible point into each of the two
open arcs between two existing marked points. -/
structure AccessibleTwoArcSplit (x y : sphere (0 : Plane) 1) where
  firstArc : Set J.carrier
  secondArc : Set J.carrier
  first_closed : IsClosed firstArc
  second_closed : IsClosed secondArc
  cover : firstArc ∪ secondArc = univ
  overlap : firstArc ∩ secondArc =
    {J.carrierHomeomorph x, J.carrierHomeomorph y}
  first_homeomorph_interval : Nonempty (firstArc ≃ₜ unitInterval)
  second_homeomorph_interval : Nonempty (secondArc ≃ₜ unitInterval)
  firstPoint : J.carrier
  firstPoint_mem_interior : firstPoint ∈
    firstArc \ {J.carrierHomeomorph x, J.carrierHomeomorph y}
  firstPoint_accessible : firstPoint ∈ J.insideAccessibleCarrier
  secondPoint : J.carrier
  secondPoint_mem_interior : secondPoint ∈
    secondArc \ {J.carrierHomeomorph x, J.carrierHomeomorph y}
  secondPoint_accessible : secondPoint ∈ J.insideAccessibleCarrier

/-- Each of the two open arcs between distinct marked points contains an
inside-accessible point.  This is the elementary refinement operation behind
the nested finite boundary decompositions in Moise 9.3. -/
theorem exists_insideAccessibleTwoArcSplit
    {x y : sphere (0 : Plane) 1} (hxy : x ≠ y) :
    Nonempty (J.AccessibleTwoArcSplit x y) := by
  obtain ⟨A, B, hA, hB, hcover, hoverlap, hAh, hBh, hApc, hBpc⟩ :=
    JordanCurve.Arcs.jordanCurve_split J.carrierHomeomorph hxy
  have hAopen : IsOpen
      (A \ {J.carrierHomeomorph x, J.carrierHomeomorph y}) := by
    rw [arc_sdiff_endpoints_eq_compl hcover hoverlap]
    exact hB.isOpen_compl
  have hBopen : IsOpen
      (B \ {J.carrierHomeomorph x, J.carrierHomeomorph y}) := by
    rw [arc_sdiff_endpoints_eq_compl (A := B) (B := A)
      (by rw [union_comm]; exact hcover)
      (by rw [inter_comm]; exact hoverlap)]
    exact hA.isOpen_compl
  have hAne : (A \ {J.carrierHomeomorph x, J.carrierHomeomorph y}).Nonempty :=
    hApc.nonempty
  have hBne : (B \ {J.carrierHomeomorph x, J.carrierHomeomorph y}).Nonempty :=
    hBpc.nonempty
  obtain ⟨a, haA, haD⟩ :=
    J.insideAccessibleCarrier_dense.inter_open_nonempty _ hAopen hAne
  obtain ⟨b, hbB, hbD⟩ :=
    J.insideAccessibleCarrier_dense.inter_open_nonempty _ hBopen hBne
  exact ⟨{
    firstArc := A
    secondArc := B
    first_closed := hA
    second_closed := hB
    cover := hcover
    overlap := hoverlap
    first_homeomorph_interval := hAh
    second_homeomorph_interval := hBh
    firstPoint := a
    firstPoint_mem_interior := haA
    firstPoint_accessible := haD
    secondPoint := b
    secondPoint_mem_interior := hbB
    secondPoint_accessible := hbD }⟩

