import Submission.Schoenflies.JordanArcPaths

/-!
# Transporting boundary paths through carrier homeomorphisms

A homeomorphism between the carriers of two Jordan circles transports not
only marked points but an entire complementary two-arc presentation.  The
paths are first lifted to the source carrier subtype, mapped there, and then
read again as ambient plane paths.
-/

namespace Schoenflies

open Set Function

noncomputable section

namespace JordanCircle.TwoBoundaryArcPaths

variable {J K : JordanCircle} {x y : Plane}
  (S : J.TwoBoundaryArcPaths x y)

theorem first_range_subset_carrier : range S.first ⊆ J.carrier := by
  intro z hz
  rw [← S.cover]
  exact Or.inl hz

theorem second_range_subset_carrier : range S.second ⊆ J.carrier := by
  intro z hz
  rw [← S.cover]
  exact Or.inr hz

/-- Exchange the two complementary arcs while retaining the endpoint order.
The old second arc is reversed to become the new first arc. -/
def swap : J.TwoBoundaryArcPaths x y where
  first := S.second.symm
  second := S.first.symm
  first_injective :=
    S.second_injective.comp unitInterval.symm_bijective.injective
  second_injective :=
    S.first_injective.comp unitInterval.symm_bijective.injective
  cover := by
    simpa only [Path.symm_range, union_comm] using S.cover
  overlap := by
    simpa only [Path.symm_range, inter_comm] using S.overlap

@[simp] theorem swap_first : S.swap.first = S.second.symm := rfl

@[simp] theorem swap_second : S.swap.second = S.first.symm := rfl

private def liftPathToCarrier {u v : Plane} (p : Path u v)
    (hp : range p ⊆ J.carrier) :
    Path (⟨u, hp (Path.source_mem_range p)⟩ : J.carrier)
      (⟨v, hp (Path.target_mem_range p)⟩ : J.carrier) where
  toFun t := ⟨p t, hp ⟨t, rfl⟩⟩
  continuous_toFun := p.continuous.subtype_mk _
  source' := Subtype.ext p.source
  target' := Subtype.ext p.target

/-- Map one ambient boundary path through a homeomorphism of carrier
subtypes, returning another ambient path. -/
def mapPath {u v : Plane} (p : Path u v)
    (hp : range p ⊆ J.carrier) (e : J.carrier ≃ₜ K.carrier) :
    Path (e ⟨u, hp (Path.source_mem_range p)⟩ : Plane)
      (e ⟨v, hp (Path.target_mem_range p)⟩ : Plane) :=
  JordanArcPaths.subtypeValPath <|
    (liftPathToCarrier p hp).map e.continuous

@[simp] theorem mapPath_apply {u v : Plane} (p : Path u v)
    (hp : range p ⊆ J.carrier) (e : J.carrier ≃ₜ K.carrier)
    (t : unitInterval) :
    mapPath p hp e t =
      (e ⟨p t, hp ⟨t, rfl⟩⟩ : Plane) := rfl

theorem mapPath_injective {u v : Plane} (p : Path u v)
    (hp : range p ⊆ J.carrier) (e : J.carrier ≃ₜ K.carrier)
    (hinj : Injective p) : Injective (mapPath p hp e) := by
  intro s t hst
  apply hinj
  have heq : e ⟨p s, hp ⟨s, rfl⟩⟩ =
      e ⟨p t, hp ⟨t, rfl⟩⟩ := Subtype.ext hst
  exact congrArg Subtype.val (e.injective heq)

/-- Transport complementary boundary paths through a carrier
homeomorphism. -/
def mapCarrier (e : J.carrier ≃ₜ K.carrier) :
    K.TwoBoundaryArcPaths
      (e ⟨x, S.first_range_subset_carrier
        (Path.source_mem_range S.first)⟩ : Plane)
      (e ⟨y, S.first_range_subset_carrier
        (Path.target_mem_range S.first)⟩ : Plane) where
  first := mapPath S.first S.first_range_subset_carrier e
  second := (mapPath S.second S.second_range_subset_carrier e).cast
    (by
      exact congrArg Subtype.val <| congrArg e <|
        Subtype.ext rfl)
    (by
      exact congrArg Subtype.val <| congrArg e <|
        Subtype.ext rfl)
  first_injective := mapPath_injective S.first
    S.first_range_subset_carrier e S.first_injective
  second_injective := by
    simpa only [Path.cast_coe] using mapPath_injective S.second
      S.second_range_subset_carrier e S.second_injective
  cover := by
    apply Set.Subset.antisymm
    · rintro z (⟨t, rfl⟩ | ⟨t, rfl⟩)
      · exact (e ⟨S.first t,
          S.first_range_subset_carrier ⟨t, rfl⟩⟩).2
      · exact (e ⟨S.second t,
          S.second_range_subset_carrier ⟨t, rfl⟩⟩).2
    · intro z hz
      let zK : K.carrier := ⟨z, hz⟩
      let w : J.carrier := e.symm zK
      have hw : (w : Plane) ∈ range S.first ∪ range S.second := by
        rw [S.cover]
        exact w.2
      rcases hw with ⟨t, ht⟩ | ⟨t, ht⟩
      · left
        refine ⟨t, ?_⟩
        change (e ⟨S.first t,
          S.first_range_subset_carrier ⟨t, rfl⟩⟩ : Plane) = z
        have hwEq :
            (⟨S.first t,
              S.first_range_subset_carrier ⟨t, rfl⟩⟩ : J.carrier) = w :=
          Subtype.ext ht
        rw [hwEq]
        exact congrArg Subtype.val (e.apply_symm_apply zK)
      · right
        refine ⟨t, ?_⟩
        change (e ⟨S.second t,
          S.second_range_subset_carrier ⟨t, rfl⟩⟩ : Plane) = z
        have hwEq :
            (⟨S.second t,
              S.second_range_subset_carrier ⟨t, rfl⟩⟩ : J.carrier) = w :=
          Subtype.ext ht
        rw [hwEq]
        exact congrArg Subtype.val (e.apply_symm_apply zK)
  overlap := by
    apply Set.Subset.antisymm
    · rintro z ⟨⟨s, hs⟩, ⟨t, ht⟩⟩
      have heq :
          e ⟨S.first s, S.first_range_subset_carrier ⟨s, rfl⟩⟩ =
            e ⟨S.second t,
              S.second_range_subset_carrier ⟨t, rfl⟩⟩ := by
        apply Subtype.ext
        exact hs.trans ht.symm
      have hsource : S.first s = S.second t :=
        congrArg Subtype.val (e.injective heq)
      have hends : S.first s ∈ ({x, y} : Set Plane) := by
        rw [← S.overlap]
        exact ⟨⟨s, rfl⟩, ⟨t, hsource.symm⟩⟩
      rcases hends with hfirst | hsecond
      · left
        rw [← hs, mapPath_apply]
        exact congrArg Subtype.val <| congrArg e <|
          Subtype.ext hfirst
      · right
        rw [← hs, mapPath_apply]
        exact congrArg Subtype.val <| congrArg e <|
          Subtype.ext (Set.mem_singleton_iff.mp hsecond)
    · intro z hz
      rcases hz with rfl | hz
      · exact ⟨Path.source_mem_range _, Path.target_mem_range _⟩
      · have hzEq := Set.mem_singleton_iff.mp hz
        subst z
        exact ⟨Path.target_mem_range _, Path.source_mem_range _⟩

@[simp] theorem mapCarrier_first (e : J.carrier ≃ₜ K.carrier) :
    (S.mapCarrier e).first =
      mapPath S.first S.first_range_subset_carrier e := rfl

@[simp] theorem mapCarrier_second_apply
    (e : J.carrier ≃ₜ K.carrier) (t : unitInterval) :
    (S.mapCarrier e).second t =
      (e ⟨S.second t,
        S.second_range_subset_carrier ⟨t, rfl⟩⟩ : Plane) := rfl

@[simp] theorem range_mapCarrier_second
    (e : J.carrier ≃ₜ K.carrier) :
    range (S.mapCarrier e).second =
      range (mapPath S.second S.second_range_subset_carrier e) := rfl

end JordanCircle.TwoBoundaryArcPaths

end

