    (S : J.TwoBoundaryArcPaths x y) (hx : x = x') (hy : y = y') :
    range (S.cast hx hy).first = range S.first := by
  rfl

@[simp] theorem range_cast_second
    (S : J.TwoBoundaryArcPaths x y) (hx : x = x') (hy : y = y') :
    range (S.cast hx hy).second = range S.second := by
  rfl

