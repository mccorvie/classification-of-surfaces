        q ∈ R.path '' Icc t (1 : unitInterval) ∧
        p ∈ J.inside ∧ q ∈ J.inside ∧
        JoinedByBrokenLine
          (J.inside ∩ thickening epsilon A.curveArcPlane) p q := by
