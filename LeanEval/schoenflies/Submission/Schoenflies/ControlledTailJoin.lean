        hQsmall hxQ⟩
    · rcases hxEndpoint with hxP | hxQ
      · have hxP' : x = p := hxP
        subst x
        exact ⟨hpInside, hfirstSmall hpFirst⟩
      · have hxQ' : x = q := mem_singleton_iff.mp hxQ
        subst x
        exact ⟨hqInside, hlastSmall hqLast⟩
  exact ⟨s, t, p, q, hspos, hst, htone, hfirstSmall, hlastSmall,
