import Submission.Schoenflies.AngularSubdivisions
import Submission.ClassificationOfSurfaces.Moise.PolygonalArc

/-!
# Crosscuts between accessible boundary points

This file records the first, non-quantitative part of Moise 9.5.  Two
linearly accessible points of the Jordan curve can be joined by a finite
polygonal chain which, apart from its endpoints, is contained in the inside.
The existing Chapter 6 loop-erasure theorem then supplies a simple polygonal
arc in the same set.
-/

namespace Schoenflies

open Metric Set Function

namespace JordanCircle

variable (J : JordanCircle)

private abbrev MoiseJoined :=
  LeanEval.Topology.ClassificationOfSurfaces.Moise.JoinedByBrokenLine

private abbrev MoiseBrokenLineData :=
  LeanEval.Topology.ClassificationOfSurfaces.Moise.BrokenLineData

/-- A loop-free polygonal chain with prescribed endpoints and with every
edge contained in `U`.  This is the stable interface consumed by the nested
cell construction; it hides the line-arrangement graph used by Chapter 6 to
erase loops. -/
structure SimpleBrokenLine (U : Set Plane) (a b : Plane) where
  data : MoiseBrokenLineData U
  start_eq : data.start = a
  finish_eq : data.finish = b
  vertex_injective : Function.Injective data.vertex

namespace SimpleBrokenLine

variable {U V : Set Plane} {a b : Plane}

/-- Enlarge the permitted carrier without changing the polygonal chain. -/
def mono (B : SimpleBrokenLine U a b) (hUV : U ⊆ V) :
    SimpleBrokenLine V a b where
  data :=
    { n := B.data.n
      vertex := B.data.vertex
      segment_subset := fun i => (B.data.segment_subset i).trans hUV }
  start_eq := B.start_eq
  finish_eq := B.finish_eq
  vertex_injective := B.vertex_injective

end SimpleBrokenLine

/-- Chapter 6 loop erasure, packaged as a simple broken line rather than an
existential graph path. -/
noncomputable def simpleBrokenLineOfJoined {U : Set Plane} {a b : Plane}
    (h : MoiseJoined U a b) : SimpleBrokenLine U a b := by
  let hex :=
    LeanEval.Topology.ClassificationOfSurfaces.Moise.BrokenLineData.exists_data_of_joined h
  let B := Classical.choose hex
  have hspec := Classical.choose_spec hex
  exact
    { data := B.resolvedBrokenLine
      start_eq := B.resolvedBrokenLine_start.trans hspec.1
      finish_eq := B.resolvedBrokenLine_finish.trans hspec.2
      vertex_injective := B.resolvedBrokenLine_vertex_injective }

/-- The ambient set in which an inside crosscut with endpoints `a,b` lives. -/
def insideCrosscutSet (a b : Plane) : Set Plane := J.inside ∪ {a, b}

/-- Any two linearly accessible boundary points admit a polygonal-chain
crosscut.  No Jordan separation argument is needed for this existence step:
join the tips of two short access hairs inside the connected component and
concatenate the three broken lines. -/
theorem joinedByBrokenLine_insideCrosscut {a b : Plane}
    (ha : a ∈ J.insideLinearlyAccessiblePoints)
    (hb : b ∈ J.insideLinearlyAccessiblePoints) :
    MoiseJoined (J.insideCrosscutSet a b) a b := by
  obtain ⟨A, -⟩ := J.exists_insideAccessHair_subset_open ha isOpen_univ (mem_univ a)
  obtain ⟨B, -⟩ := J.exists_insideAccessHair_subset_open hb isOpen_univ (mem_univ b)
  have hA : MoiseJoined (J.insideCrosscutSet a b) a A.tip := by
    apply LeanEval.Topology.ClassificationOfSurfaces.Moise.JoinedByBrokenLine.of_segment
    intro x hx
    rcases A.carrier_subset hx with hxI | hxa
    · exact Or.inl hxI
    · have hxa' : x = a := mem_singleton_iff.mp hxa
      exact Or.inr (by simp [hxa'])
  have hmid : MoiseJoined (J.insideCrosscutSet a b) A.tip B.tip := by
    have hAtip : A.tip ∈ J.inside := by
      rcases A.carrier_subset A.tip_mem with h | h
      · exact h
      · exact False.elim (A.tip_ne_base (mem_singleton_iff.mp h))
    have hBtip : B.tip ∈ J.inside := by
      rcases B.carrier_subset B.tip_mem with h | h
      · exact h
      · exact False.elim (B.tip_ne_base (mem_singleton_iff.mp h))
    exact (LeanEval.Topology.ClassificationOfSurfaces.Moise.IsPreconnected.joinedByBrokenLine
      J.inside_isOpen J.inside_isConnected.isPreconnected hAtip hBtip).mono
        subset_union_left
  have hB : MoiseJoined (J.insideCrosscutSet a b) B.tip b := by
    apply LeanEval.Topology.ClassificationOfSurfaces.Moise.JoinedByBrokenLine.of_segment
    rw [segment_symm]
    intro x hx
    rcases B.carrier_subset hx with hxI | hxb
    · exact Or.inl hxI
    · have hxb' : x = b := mem_singleton_iff.mp hxb
      exact Or.inr (by simp [hxb'])
  exact (hA.trans hmid).trans hB

/-- The existing Moise Chapter 6 loop-erasure machinery turns the preceding
chain into a simple finite graph path, still contained in the inside together
with its two boundary endpoints. -/
theorem exists_polygonalArc_insideCrosscut {a b : Plane}
    (ha : a ∈ J.insideLinearlyAccessiblePoints)
    (hb : b ∈ J.insideLinearlyAccessiblePoints) :
    ∃ B : LeanEval.Topology.ClassificationOfSurfaces.Moise.BrokenLineData
        (J.insideCrosscutSet a b),
      B.start = a ∧ B.finish = b ∧
      Nonempty (B.inSetGraph.Path
        (B.arrangementVertex 0) (B.arrangementVertex (Fin.last B.n))) :=
  (J.joinedByBrokenLine_insideCrosscut ha hb).exists_polygonalArc

/-- A simple polygonal crosscut between two accessible boundary points.  Its
edge carrier is contained in the inside together with the two endpoints by
the type of its underlying `BrokenLineData`. -/
noncomputable def simpleInsideCrosscut {a b : Plane}
    (ha : a ∈ J.insideLinearlyAccessiblePoints)
    (hb : b ∈ J.insideLinearlyAccessiblePoints) :
    SimpleBrokenLine (J.insideCrosscutSet a b) a b :=
  simpleBrokenLineOfJoined (J.joinedByBrokenLine_insideCrosscut ha hb)

/-- Before the separation step of Moise 9.5, Chapter 1 already gives a
polygonal chain arbitrarily close to the selected boundary subarc. -/
theorem AccessibleAngularArc.joinedByBrokenLine_in_thickening
    (A : J.AccessibleAngularArc) {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    MoiseJoined (Metric.thickening epsilon A.curveArcPlane)
      (J.curvePoint A.left) (J.curvePoint A.right) := by
  exact LeanEval.Topology.ClassificationOfSurfaces.Moise.brokenLine_in_thickening_of_preconnected
      A.curveArcPlane_isPreconnected A.left_mem_curveArcPlane
      A.right_mem_curveArcPlane hepsilon

/-- Loop-erasing the near-arc chain retains the same metric control.  The
remaining content of Moise 9.5 is to select such an arc on the inside side
of the Jordan curve. -/
theorem AccessibleAngularArc.exists_polygonalArc_in_thickening
    (A : J.AccessibleAngularArc) {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ B : LeanEval.Topology.ClassificationOfSurfaces.Moise.BrokenLineData
        (Metric.thickening epsilon A.curveArcPlane),
      B.start = J.curvePoint A.left ∧ B.finish = J.curvePoint A.right ∧
      Nonempty (B.inSetGraph.Path
        (B.arrangementVertex 0) (B.arrangementVertex (Fin.last B.n))) :=
  (AccessibleAngularArc.joinedByBrokenLine_in_thickening J A hepsilon).exists_polygonalArc

/-- The loop-free form of the metric approximation to a boundary subarc.
This is deliberately separate from `simpleInsideCrosscut`: the outstanding
Moise 9.5 frame argument is exactly what makes one simple line satisfy both
the metric and the inside-side constraints simultaneously. -/
noncomputable def AccessibleAngularArc.simpleBrokenLine_in_thickening
    (A : J.AccessibleAngularArc) {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    SimpleBrokenLine (Metric.thickening epsilon A.curveArcPlane)
      (J.curvePoint A.left) (J.curvePoint A.right) :=
  simpleBrokenLineOfJoined
    (AccessibleAngularArc.joinedByBrokenLine_in_thickening J A hepsilon)

/-- The exact carrier allowed for the controlled inside crosscut in Moise
9.5: all non-endpoint edges must lie both inside the Jordan curve and within
the prescribed metric neighborhood of the selected boundary arc. -/
def AccessibleAngularArc.controlledInsideCrosscutSet
    (A : J.AccessibleAngularArc) (epsilon : ℝ) : Set Plane :=
  (J.inside ∩ Metric.thickening epsilon A.curveArcPlane) ∪
    {(J.curvePoint A.left : Plane), (J.curvePoint A.right : Plane)}

/-- Proposition-valued statement of Moise 9.5, separated from all later
nested-cell bookkeeping. -/
def AccessibleAngularArc.HasControlledInsideCrosscut
    (A : J.AccessibleAngularArc) (epsilon : ℝ) : Prop :=
  Nonempty (SimpleBrokenLine (AccessibleAngularArc.controlledInsideCrosscutSet J A epsilon)
    (J.curvePoint A.left) (J.curvePoint A.right))

/-- Metric control is monotone in the permitted radius. -/
theorem AccessibleAngularArc.HasControlledInsideCrosscut.mono
    (A : J.AccessibleAngularArc) {epsilon delta : ℝ}
    (h : AccessibleAngularArc.HasControlledInsideCrosscut J A epsilon)
    (hed : epsilon ≤ delta) :
    AccessibleAngularArc.HasControlledInsideCrosscut J A delta := by
  obtain ⟨B⟩ := h
  exact ⟨B.mono (by
    intro x hx
    rcases hx with hx | hx
    · exact Or.inl ⟨hx.1, thickening_mono hed _ hx.2⟩
    · exact Or.inr hx)⟩

end JordanCircle

end Schoenflies
