  rw [q.symm_apply_apply] at hnext
  have heq :
      q (cyclicSuccIndex l F.orderedLevelEdges_nonempty
        (cyclicSuccIndex l F.orderedLevelEdges_nonempty i)) = q i :=
    hnext.trans hi.symm
  exact (cyclicSuccIndex_sq_ne l F.orderedLevelEdges_nonempty
