/-- After deleting the finite seam exceptions, every frontier point of the
filled cyclic target union lies on the outer standard polygon. -/
theorem frontier_sdiff_cyclicTargetCellExceptionalSet_subset_outerCarrier
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) :
    frontier (I.cyclicTargetFilledDisk m n) \
        I.cyclicTargetCellExceptionalSet m n ⊆
      (disk (m + 1)).carrier := by
  have hclosed : IsClosed (I.cyclicTargetFilledDisk m n) :=
    (I.isCompact_cyclicTargetFilledDisk m n).isClosed
  have hinnerInterior : (disk m).interiorRegion ⊆
      interior (I.cyclicTargetFilledDisk m n) := by
    apply interior_maximal
    · intro x hx
      left
      rw [(disk m).closedRegion_eq_union]
      exact Or.inl hx
    · exact (disk m).isOpen_interiorRegion
  have hcellInterior (a : LevelAddress n) :
      (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion ⊆
        interior (I.cyclicTargetFilledDisk m n) := by
    apply interior_maximal
    · intro x hx
      right
      exact Set.mem_iUnion.mpr ⟨a, by
        rw [(I.cyclicTargetAttachmentPresentation m a).disk.closedRegion_eq_union]
        exact Or.inl hx⟩
    · exact (I.cyclicTargetAttachmentPresentation m a).disk.isOpen_interiorRegion
  rintro x ⟨hxFrontier, hxNotExceptional⟩
  have hxFilled : x ∈ I.cyclicTargetFilledDisk m n :=
    hclosed.frontier_subset hxFrontier
  rcases hxFilled with hxInner | hxCells
  · rw [(disk m).closedRegion_eq_union] at hxInner
    rcases hxInner with hxInnerInterior | hxInnerCarrier
    · exact False.elim <| Set.disjoint_left.mp disjoint_interior_frontier
        (hinnerInterior hxInnerInterior) hxFrontier
    · obtain ⟨a, hxShared⟩ := Set.mem_iUnion.mp <|
        I.targetInnerCarrier_subset_iUnion_cyclicTargetCellShared
          m n hxInnerCarrier
      have hxInterior :=
        I.targetShared_mem_interior_cyclicTargetFilledDisk
          m hn a hxShared hxNotExceptional
      exact False.elim <| Set.disjoint_left.mp
        disjoint_interior_frontier hxInterior hxFrontier
  · obtain ⟨a, hxCell⟩ := Set.mem_iUnion.mp hxCells
    let C := I.cyclicTargetAttachmentPresentation m a
    change x ∈ C.disk.closedRegion at hxCell
    rw [C.disk.closedRegion_eq_union] at hxCell
    rcases hxCell with hxCellInterior | hxCellCarrier
    · exact False.elim <| Set.disjoint_left.mp disjoint_interior_frontier
        (hcellInterior a hxCellInterior) hxFrontier
    · dsimp only [C] at hxCellCarrier
      rw [(I.cyclicTargetAttachmentPresentation m a).carrier_eq,
        I.range_cyclicTargetAttachmentPresentation_exposed m hn]
        at hxCellCarrier
      rcases hxCellCarrier with
        hxShared | hxSuccessorCut | hxOuter | hxInitialCut
      · have hxInterior :=
          I.targetShared_mem_interior_cyclicTargetFilledDisk
            m hn a hxShared hxNotExceptional
        exact False.elim <| Set.disjoint_left.mp
          disjoint_interior_frontier hxInterior hxFrontier
      · have hxInterior :=
          I.targetSuccessorCut_mem_interior_cyclicTargetFilledDisk
            m hn a hxSuccessorCut hxNotExceptional
        exact False.elim <| Set.disjoint_left.mp
          disjoint_interior_frontier hxInterior hxFrontier
      · rw [← (disk (m + 1)).carrier_toJordanCircle,
          ← (I.indexedTargetBoundarySplit (m + 1) a).cover]
        exact Or.inl hxOuter
      · let previous : LevelAddress n := prevLevelAddress n a
        have hxPreviousSuccessor : x ∈ range
            (I.indexedTargetAnnularCrosscut m
              (nextLevelAddress n previous)).path := by
          change x ∈ range
            (I.indexedTargetAnnularCrosscut m a).path at hxInitialCut
          dsimp only [previous]
          rw [nextLevelAddress_prevLevelAddress]
          exact hxInitialCut
        have hxInterior :=
          I.targetSuccessorCut_mem_interior_cyclicTargetFilledDisk
            m hn previous hxPreviousSuccessor hxNotExceptional
        exact False.elim <| Set.disjoint_left.mp
          disjoint_interior_frontier hxInterior hxFrontier

/-- The finite exceptional set contributes no isolated frontier points, so
the entire frontier lies on the outer standard polygon. -/
theorem frontier_cyclicTargetFilledDisk_subset_outerCarrier
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) :
    frontier (I.cyclicTargetFilledDisk m n) ⊆
      (disk (m + 1)).carrier := by
  have hclosed : IsClosed (I.cyclicTargetFilledDisk m n) :=
    (I.isCompact_cyclicTargetFilledDisk m n).isClosed
  have hdense : frontier (I.cyclicTargetFilledDisk m n) ⊆
      closure (frontier (I.cyclicTargetFilledDisk m n) \
        I.cyclicTargetCellExceptionalSet m n) :=
    frontier_subset_closure_sdiff_finite_of_regularClosed
      hclosed (I.closure_interior_cyclicTargetFilledDisk m n)
      (I.cyclicTargetCellExceptionalSet_finite m n)
  have houterClosed : IsClosed (disk (m + 1)).carrier :=
    (disk (m + 1)).isCompact_carrier.isClosed
  exact hdense.trans <| by
    have hclosure := closure_mono
      (I.frontier_sdiff_cyclicTargetCellExceptionalSet_subset_outerCarrier
        m hn)
    rwa [houterClosed.closure_eq] at hclosure

/-- The inner standard disk and all canonical cyclic cells fill the outer
standard disk. -/
theorem cyclicTargetFilledDisk_eq_outerClosedRegion
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) :
    I.cyclicTargetFilledDisk m n = (disk (m + 1)).closedRegion := by
  have hinnerInterior : (disk m).interiorRegion ⊆
      interior (I.cyclicTargetFilledDisk m n) := by
    apply interior_maximal
    · intro x hx
      left
      rw [(disk m).closedRegion_eq_union]
      exact Or.inl hx
    · exact (disk m).isOpen_interiorRegion
  let p : Plane := (disk m).toJordanCircle.insidePoint
  have hpInner : p ∈ (disk m).interiorRegion := by
    rw [← (disk m).inside_toJordanCircle]
    exact (disk m).toJordanCircle.insidePoint_mem_inside
  have hpOuter : p ∈ (disk (m + 1)).toJordanCircle.inside := by
    rw [(disk (m + 1)).inside_toJordanCircle]
    apply disk_strictlyNested m
    rw [(disk m).closedRegion_eq_union]
    exact Or.inl hpInner
  have hintersection :
      (interior (I.cyclicTargetFilledDisk m n) ∩
        (disk (m + 1)).toJordanCircle.inside).Nonempty :=
    ⟨p, hinnerInterior hpInner, hpOuter⟩
  have hrecognition :=
    (disk (m + 1)).toJordanCircle.eq_closure_inside_of_isCompact_frontier_subset
      (I.isCompact_cyclicTargetFilledDisk m n)
      (by
        rw [(disk (m + 1)).inside_toJordanCircle]
        exact I.cyclicTargetFilledDisk_subset_outerClosedRegion m hn)
      (by
        rw [(disk (m + 1)).carrier_toJordanCircle]
        exact I.frontier_cyclicTargetFilledDisk_subset_outerCarrier m hn)
      hintersection
  rw [(disk (m + 1)).inside_toJordanCircle] at hrecognition
  exact hrecognition

theorem iUnion_cyclicTargetCell_subset_standardClosedShell
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) :
    (⋃ a : LevelAddress n,
        (I.cyclicTargetAttachmentPresentation m a).disk.closedRegion) ⊆
      PolygonalCircle.closedShell (disk m) (disk (m + 1)) := by
  intro x hx
  obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hx
  refine ⟨I.cyclicTargetCell_closedRegion_subset_outerDisk m hn a hxa, ?_⟩
  intro hxInnerInterior
  have hxInnerClosed : x ∈ (disk m).closedRegion := by
    rw [(disk m).closedRegion_eq_union]
    exact Or.inl hxInnerInterior
  have hxShared : x ∈
      range (I.cyclicTargetAttachmentPresentation m a).shared := by
    rw [← (I.cyclicTargetAttachmentPresentation m a).base_inter_disk]
    exact ⟨hxInnerClosed, hxa⟩
  have hxInnerCarrier : x ∈ (disk m).carrier := by
    rw [I.range_cyclicTargetAttachmentPresentation_shared] at hxShared
    simpa only [(disk m).carrier_toJordanCircle] using
      (I.indexedTargetBoundarySplit m a).first_range_subset_carrier hxShared
  exact Set.disjoint_left.mp
    (PolygonalCircle.carrier_disjoint_interiorRegion (disk m))
    hxInnerCarrier hxInnerInterior

/-- The canonical cyclic target cells are exactly the full standard closed
shell between consecutive radial levels. -/
theorem iUnion_cyclicTargetCell_eq_standardClosedShell
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) :
    (⋃ a : LevelAddress n,
        (I.cyclicTargetAttachmentPresentation m a).disk.closedRegion) =
      PolygonalCircle.closedShell (disk m) (disk (m + 1)) := by
  apply Set.Subset.antisymm
  · exact I.iUnion_cyclicTargetCell_subset_standardClosedShell m hn
  · intro x hxShell
    have hxFilled : x ∈ I.cyclicTargetFilledDisk m n := by
      rw [I.cyclicTargetFilledDisk_eq_outerClosedRegion m hn]
      exact hxShell.1
    rcases hxFilled with hxInner | hxCells
    · rw [(disk m).closedRegion_eq_union] at hxInner
      have hxInnerCarrier : x ∈ (disk m).carrier :=
        hxInner.resolve_left hxShell.2
      obtain ⟨a, hxShared⟩ := Set.mem_iUnion.mp <|
        I.targetInnerCarrier_subset_iUnion_cyclicTargetCellShared
          m n hxInnerCarrier
      obtain ⟨t, rfl⟩ := hxShared
      exact Set.mem_iUnion.mpr ⟨a,
        (I.cyclicTargetAttachmentPresentation m a).shared_mem_closedRegion t⟩
    · exact hxCells

end JordanCircle.InitialAngularArcs

