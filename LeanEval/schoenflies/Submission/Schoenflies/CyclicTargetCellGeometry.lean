/-- Every third radial cut misses the boundary of the target cell between
`a` and its cyclic successor. -/
theorem other_indexedTargetCrosscut_disjoint_cellCarrier
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) (a c : LevelAddress n)
    (hca : c ≠ a) (hcnext : c ≠ nextLevelAddress n a) :
    Disjoint (range (I.indexedTargetAnnularCrosscut m c).path)
      (I.cyclicTargetAttachmentPresentation m a).disk.carrier := by
  apply Set.disjoint_left.mpr
  intro x hxCut hxCell
  rw [(I.cyclicTargetAttachmentPresentation m a).carrier_eq,
    I.range_cyclicTargetAttachmentPresentation_shared,
    I.range_cyclicTargetAttachmentPresentation_exposed m hn] at hxCell
  rcases hxCell with hxInner | hxSecond | hxOuter | hxFirst
  · have hxMeet : x ∈
        range (I.indexedTargetAnnularCrosscut m c).path ∩
          (disk m).carrier :=
      ⟨hxCut,
        by
          simpa only [(disk m).carrier_toJordanCircle] using
            (I.indexedTargetBoundarySplit m a).first_range_subset_carrier hxInner⟩
    rw [(I.indexedTargetAnnularCrosscut m c).range_inter_inner] at hxMeet
    have hxEq := Set.mem_singleton_iff.mp hxMeet
    subst x
    have hxOther := I.other_indexedTargetMark_mem_boundarySplit_second
      m a c hca hcnext
    have hxEnds : I.indexedTargetMark m c ∈
        ({I.indexedTargetMark m a,
          I.indexedTargetMark m (nextLevelAddress n a)} : Set Plane) := by
      rw [← (I.indexedTargetBoundarySplit m a).overlap]
      exact ⟨hxInner, hxOther⟩
    rcases hxEnds with hEq | hEq
    · exact hca (I.indexedTargetMark_injective m n hEq)
    · exact hcnext (I.indexedTargetMark_injective m n
        (Set.mem_singleton_iff.mp hEq))
  · exact Set.disjoint_left.mp
      (I.pairwise_disjoint_indexedTargetAnnularCrosscut m n hcnext)
      hxCut hxSecond
  · have hxMeet : x ∈
        range (I.indexedTargetAnnularCrosscut m c).path ∩
          (disk (m + 1)).carrier := by
      refine ⟨hxCut, ?_⟩
      rw [← (disk (m + 1)).carrier_toJordanCircle,
        ← (I.indexedTargetBoundarySplit (m + 1) a).cover]
      exact Or.inl hxOuter
    rw [(I.indexedTargetAnnularCrosscut m c).range_inter_outer] at hxMeet
    have hxEq := Set.mem_singleton_iff.mp hxMeet
    subst x
    have hxOther := I.other_indexedTargetMark_mem_boundarySplit_second
      (m + 1) a c hca hcnext
    have hxEnds : I.indexedTargetMark (m + 1) c ∈
        ({I.indexedTargetMark (m + 1) a,
          I.indexedTargetMark (m + 1) (nextLevelAddress n a)} : Set Plane) := by
      rw [← (I.indexedTargetBoundarySplit (m + 1) a).overlap]
      exact ⟨hxOuter, hxOther⟩
    rcases hxEnds with hEq | hEq
    · exact hca (I.indexedTargetMark_injective (m + 1) n hEq)
    · exact hcnext (I.indexedTargetMark_injective (m + 1) n
        (Set.mem_singleton_iff.mp hEq))
  · exact Set.disjoint_left.mp
      (I.pairwise_disjoint_indexedTargetAnnularCrosscut m n hca)
      hxCut hxFirst

theorem indexedTargetFirstCrosscut_range_subset_cellCarrier
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) (a : LevelAddress n) :
    range (I.cyclicTargetDecomposition m a).first.path ⊆
      (I.cyclicTargetAttachmentPresentation m a).disk.carrier := by
  intro x hx
  rw [(I.cyclicTargetAttachmentPresentation m a).carrier_eq,
    I.range_cyclicTargetAttachmentPresentation_exposed m hn]
  exact Or.inr (Or.inr (Or.inr hx))

theorem indexedTargetSecondCrosscut_range_subset_cellCarrier
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) (a : LevelAddress n) :
    range (I.cyclicTargetDecomposition m a).second.path ⊆
      (I.cyclicTargetAttachmentPresentation m a).disk.carrier := by
  intro x hx
  rw [(I.cyclicTargetAttachmentPresentation m a).carrier_eq,
    I.range_cyclicTargetAttachmentPresentation_exposed m hn]
  exact Or.inr (Or.inl hx)

theorem cyclicTargetCell_closedRegion_subset_outerDisk
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) (a : LevelAddress n) :
    (I.cyclicTargetAttachmentPresentation m a).disk.closedRegion ⊆
      (disk (m + 1)).closedRegion := by
  intro x hx
  rw [← (I.cyclicTargetDecomposition m a).cellClosedRegions_union]
  have hfirst := I.cyclicTargetFirstAlternative_of_one_le m hn a
  right
  rw [cyclicTargetAttachmentPresentation, dif_pos hfirst] at hx
  exact hx

theorem targetInnerDisk_disjoint_cyclicTargetCellInterior
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) (a : LevelAddress n) :
    Disjoint (disk m).closedRegion
      (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion := by
  rw [Set.disjoint_left]
  intro x hxInner hxInterior
  have hxClosed : x ∈
      (I.cyclicTargetAttachmentPresentation m a).disk.closedRegion := by
    rw [(I.cyclicTargetAttachmentPresentation m a).disk.closedRegion_eq_union]
    exact Or.inl hxInterior
  have hxShared : x ∈
      range (I.cyclicTargetAttachmentPresentation m a).shared := by
    rw [← (I.cyclicTargetAttachmentPresentation m a).base_inter_disk]
    exact ⟨hxInner, hxClosed⟩
  have hxCarrier : x ∈
      (I.cyclicTargetAttachmentPresentation m a).disk.carrier := by
    rw [(I.cyclicTargetAttachmentPresentation m a).carrier_eq]
    exact Or.inl hxShared
  exact Set.disjoint_left.mp
    (PolygonalCircle.carrier_disjoint_interiorRegion _)
    hxCarrier hxInterior

theorem targetOuterCarrier_disjoint_cyclicTargetCellInterior
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) (a : LevelAddress n) :
    Disjoint (disk (m + 1)).carrier
      (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion := by
  apply Set.disjoint_left.mpr
  intro x hxOuter hxCell
  have hxSubset :
      (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion ⊆
        (disk (m + 1)).interiorRegion := by
    rw [← (I.cyclicTargetAttachmentPresentation m a).disk.interior_closedRegion,
      ← (disk (m + 1)).interior_closedRegion]
    exact interior_mono (I.cyclicTargetCell_closedRegion_subset_outerDisk
      m hn a)
  exact Set.disjoint_left.mp
    (PolygonalCircle.carrier_disjoint_interiorRegion (disk (m + 1)))
    hxOuter (hxSubset hxCell)

theorem indexedTargetCrosscut_disjoint_cyclicTargetCellInterior
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n)
    (a c : LevelAddress n) :
    Disjoint (range (I.indexedTargetAnnularCrosscut m c).path)
      (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion := by
  by_cases hca : c = a
  · subst c
    exact (PolygonalCircle.carrier_disjoint_interiorRegion
      (I.cyclicTargetAttachmentPresentation m a).disk).mono_left
        (I.indexedTargetFirstCrosscut_range_subset_cellCarrier m hn a)
  by_cases hcnext : c = nextLevelAddress n a
  · subst c
    exact (PolygonalCircle.carrier_disjoint_interiorRegion
      (I.cyclicTargetAttachmentPresentation m a).disk).mono_left
        (I.indexedTargetSecondCrosscut_range_subset_cellCarrier m hn a)
  have hOff := I.other_indexedTargetCrosscut_disjoint_cellCarrier
    m hn a c hca hcnext
  have hInnerClosed : (I.indexedTargetAnnularCrosscut m c).innerPoint ∈
      (disk m).closedRegion := by
    rw [(disk m).closedRegion_eq_union]
    exact Or.inr (I.indexedTargetAnnularCrosscut m c).innerPoint_mem
  have hInnerNotInterior :
      (I.indexedTargetAnnularCrosscut m c).innerPoint ∉
        (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion :=
    Set.disjoint_left.mp
      (I.targetInnerDisk_disjoint_cyclicTargetCellInterior m hn a)
      hInnerClosed
  have hInnerNotCarrier :
      (I.indexedTargetAnnularCrosscut m c).innerPoint ∉
        (I.cyclicTargetAttachmentPresentation m a).disk.carrier :=
    Set.disjoint_left.mp hOff
      (Path.target_mem_range (I.indexedTargetAnnularCrosscut m c).path)
  have hInnerExterior :
      (I.indexedTargetAnnularCrosscut m c).innerPoint ∈
        (I.cyclicTargetAttachmentPresentation m a).disk.exteriorRegion := by
    have hSplit : (I.indexedTargetAnnularCrosscut m c).innerPoint ∈
        (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion ∪
          (I.cyclicTargetAttachmentPresentation m a).disk.exteriorRegion := by
      rw [(I.cyclicTargetAttachmentPresentation m a).disk.interior_union_exterior]
      exact hInnerNotCarrier
    exact hSplit.resolve_left hInnerNotInterior
  have hMaps : MapsTo (I.indexedTargetAnnularCrosscut m c).path
      Set.univ
      (I.cyclicTargetAttachmentPresentation m a).disk.exteriorRegion :=
    (I.cyclicTargetAttachmentPresentation m a).disk.mapsTo_exteriorRegion_of_isPreconnected
        isPreconnected_univ
        (I.indexedTargetAnnularCrosscut m c).path.continuous.continuousOn
        (by
          intro t _ htCarrier
          exact Set.disjoint_left.mp hOff ⟨t, rfl⟩ htCarrier)
        ⟨1, Set.mem_univ _, by
          simpa only [Path.target] using hInnerExterior⟩
  apply Set.disjoint_left.mpr
  rintro x ⟨t, rfl⟩ hxInterior
  exact Set.disjoint_left.mp
    (I.cyclicTargetAttachmentPresentation m a).disk.disjoint_interior_exterior
    hxInterior (hMaps (Set.mem_univ t))

theorem cyclicTargetCellCarrier_disjoint_cellInterior
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n)
    (a b : LevelAddress n) :
    Disjoint (I.cyclicTargetAttachmentPresentation m b).disk.carrier
      (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion := by
  apply Set.disjoint_left.mpr
  intro x hxB hxA
  rw [(I.cyclicTargetAttachmentPresentation m b).carrier_eq,
    I.range_cyclicTargetAttachmentPresentation_shared,
    I.range_cyclicTargetAttachmentPresentation_exposed m hn] at hxB
  rcases hxB with hxInner | hxSecond | hxOuter | hxFirst
  · have hxInnerClosed : x ∈ (disk m).closedRegion := by
      rw [(disk m).closedRegion_eq_union]
      exact Or.inr <|
        by
          simpa only [(disk m).carrier_toJordanCircle] using
            (I.indexedTargetBoundarySplit m b).first_range_subset_carrier hxInner
    exact Set.disjoint_left.mp
      (I.targetInnerDisk_disjoint_cyclicTargetCellInterior m hn a)
      hxInnerClosed hxA
  · exact Set.disjoint_left.mp
      (I.indexedTargetCrosscut_disjoint_cyclicTargetCellInterior
        m hn a (nextLevelAddress n b)) hxSecond hxA
  · have hxOuterCarrier : x ∈ (disk (m + 1)).carrier := by
      rw [← (disk (m + 1)).carrier_toJordanCircle,
        ← (I.indexedTargetBoundarySplit (m + 1) b).cover]
      exact Or.inl hxOuter
    exact Set.disjoint_left.mp
      (I.targetOuterCarrier_disjoint_cyclicTargetCellInterior m hn a)
      hxOuterCarrier hxA
  · exact Set.disjoint_left.mp
      (I.indexedTargetCrosscut_disjoint_cyclicTargetCellInterior m hn a b)
      hxFirst hxA

theorem exists_cyclicTargetCellCarrier_not_mem_otherCarrier
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n)
    (a b : LevelAddress n) (hab : a ≠ b) :
    ∃ x, x ∈ (I.cyclicTargetAttachmentPresentation m b).disk.carrier ∧
      x ∉ (I.cyclicTargetAttachmentPresentation m a).disk.carrier := by
  by_cases hbnext : b = nextLevelAddress n a
  · have hnextb : nextLevelAddress n b ≠ a := by
      intro h
      apply nextLevelAddress_next_ne n hn a
      rw [← hbnext]
      exact h
    have hnextnext : nextLevelAddress n b ≠ nextLevelAddress n a := by
      intro h
      exact hab (nextLevelAddress_injective n h).symm
    refine ⟨(I.indexedTargetAnnularCrosscut m
      (nextLevelAddress n b)).innerPoint,
      I.indexedTargetSecondCrosscut_range_subset_cellCarrier m hn b
        (Path.target_mem_range _), ?_⟩
    exact Set.disjoint_left.mp
      (I.other_indexedTargetCrosscut_disjoint_cellCarrier
        m hn a (nextLevelAddress n b) hnextb hnextnext)
      (Path.target_mem_range _)
  · refine ⟨(I.indexedTargetAnnularCrosscut m b).innerPoint,
      I.indexedTargetFirstCrosscut_range_subset_cellCarrier m hn b
        (Path.target_mem_range _), ?_⟩
    exact Set.disjoint_left.mp
      (I.other_indexedTargetCrosscut_disjoint_cellCarrier
        m hn a b hab.symm hbnext)
      (Path.target_mem_range _)

set_option maxHeartbeats 500000 in
-- The generic Jordan-region separation theorem unfolds both polygonal cells.
theorem disjoint_cyclicTargetCellInterior
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n)
    (a b : LevelAddress n) (hab : a ≠ b) :
    Disjoint (I.cyclicTargetAttachmentPresentation m a).disk.interiorRegion
      (I.cyclicTargetAttachmentPresentation m b).disk.interiorRegion := by
  exact (I.cyclicTargetAttachmentPresentation m a).disk.disjoint_interiorRegion_of_boundary_avoidance
      (I.cyclicTargetAttachmentPresentation m b).disk
      (I.cyclicTargetCellCarrier_disjoint_cellInterior m hn b a)
      (I.cyclicTargetCellCarrier_disjoint_cellInterior m hn a b)
      (I.exists_cyclicTargetCellCarrier_not_mem_otherCarrier m hn a b hab)

/-- At either radius, the circular sides of two distinct canonical cells meet
only at the two labelled endpoints of the first cell. -/
theorem indexedTargetBoundarySplit_first_inter_subset_endpoints
    (m : ℕ) {n : ℕ} (hn : 1 ≤ n) {a b : LevelAddress n} (hab : a ≠ b) :
    range (I.indexedTargetBoundarySplit m a).first ∩
        range (I.indexedTargetBoundarySplit m b).first ⊆
      ({I.indexedTargetMark m a,
        I.indexedTargetMark m (nextLevelAddress n a)} : Set Plane) := by
  exact JordanCircle.TwoBoundaryArcPaths.successorSplitFamily_first_inter_subset_endpoints
    (J := (disk m).toJordanCircle)
    (fun c : LevelAddress n => I.indexedTargetMark m c)
    (I.indexedTargetMark_injective m n)
    (nextLevelAddress n)
    (nextLevelAddress_injective n)
    (nextLevelAddress_next_ne n hn)
    (fun c => I.indexedTargetBoundarySplit m c)
    (fun c d hdc hdnext =>
      I.other_indexedTargetMark_mem_boundarySplit_second
        m c d hdc hdnext)
    hab

/-- A retained radial mark lies on a canonical circular side exactly when it
is one of that side's two endpoint labels. -/
theorem indexedTargetMark_mem_boundarySplit_first_iff
    (m : ℕ) {n : ℕ} (a c : LevelAddress n) :
    I.indexedTargetMark m c ∈
        range (I.indexedTargetBoundarySplit m a).first ↔
      c = a ∨ c = nextLevelAddress n a := by
  constructor
  · intro hc
    by_cases hca : c = a
    · exact Or.inl hca
    by_cases hcnext : c = nextLevelAddress n a
    · exact Or.inr hcnext
    have hcSecond := I.other_indexedTargetMark_mem_boundarySplit_second
      m a c hca hcnext
    have hcEnds : I.indexedTargetMark m c ∈
        ({I.indexedTargetMark m a,
          I.indexedTargetMark m (nextLevelAddress n a)} : Set Plane) := by
      rw [← (I.indexedTargetBoundarySplit m a).overlap]
      exact ⟨hc, hcSecond⟩
    rcases hcEnds with h | h
    · exact False.elim (hca (I.indexedTargetMark_injective m n h))
    · exact False.elim (hcnext (I.indexedTargetMark_injective m n
        (Set.mem_singleton_iff.mp h)))
  · intro h
    rcases h with h | h
    · subst c
      exact Path.source_mem_range (I.indexedTargetBoundarySplit m a).first
    · subst c
      exact Path.target_mem_range (I.indexedTargetBoundarySplit m a).first

