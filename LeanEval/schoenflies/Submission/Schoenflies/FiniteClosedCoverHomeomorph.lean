import Submission.Schoenflies.ClosedCoverHomeomorph

/-!
# Gluing homeomorphisms on finite closed covers

Moise's Chapter 9 construction fills finitely many closed polygonal cells at
each stage.  This file iterates the two-member closed-cover gluing theorem.
The hypotheses are deliberately pairwise: in applications it is enough to
check that the prescribed cell maps agree on their common skeleton.
-/

namespace Schoenflies

open Set

noncomputable section

namespace FiniteClosedCoverHomeomorph

variable {X Y ι : Type*} [TopologicalSpace X] [TopologicalSpace Y]

/-- The union of a finite family of sets. -/
def cover (u : Finset ι) (s : ι → Set X) : Set X :=
  ⋃ i ∈ u, s i

theorem mem_cover_iff {u : Finset ι} {s : ι → Set X} {x : X} :
    x ∈ cover u s ↔ ∃ i ∈ u, x ∈ s i := by
  simp [cover]

theorem subset_cover {u : Finset ι} {s : ι → Set X} {i : ι}
    (hi : i ∈ u) : s i ⊆ cover u s := by
  intro x hx
  exact mem_cover_iff.mpr ⟨i, hi, hx⟩

theorem isClosed_cover {u : Finset ι} {s : ι → Set X}
    (hs : ∀ i ∈ u, IsClosed (s i)) : IsClosed (cover u s) := by
  exact isClosed_biUnion_finset hs

theorem cover_insert [DecidableEq ι] (a : ι) (u : Finset ι)
    (s : ι → Set X) :
    cover (insert a u) s = cover u s ∪ s a := by
  ext x
  simp only [mem_cover_iff, Finset.mem_insert, mem_union]
  constructor
  · rintro ⟨i, rfl | hi, hxi⟩
    · exact Or.inr hxi
    · exact Or.inl ⟨i, hi, hxi⟩
  · rintro (⟨i, hi, hxi⟩ | hxa)
    · exact ⟨i, Or.inr hi, hxi⟩
    · exact ⟨a, Or.inl rfl, hxa⟩

/-- Pairwise-compatible homeomorphisms on finite closed covers glue to a
homeomorphism of their unions.  The conclusion records its value on every
member of the cover, independently of which membership proof is used. -/
theorem exists_glue
    (u : Finset ι)
    (s : ι → Set X) (t : ι → Set Y)
    (hs : ∀ i ∈ u, IsClosed (s i))
    (ht : ∀ i ∈ u, IsClosed (t i))
    (e : ∀ i, s i ≃ₜ t i)
    (hforward : ∀ i ∈ u, ∀ j ∈ u, ∀ x (hxi : x ∈ s i) (hxj : x ∈ s j),
      (e i ⟨x, hxi⟩ : Y) = e j ⟨x, hxj⟩)
    (hbackward : ∀ i ∈ u, ∀ j ∈ u, ∀ y (hyi : y ∈ t i) (hyj : y ∈ t j),
      ((e i).symm ⟨y, hyi⟩ : X) = (e j).symm ⟨y, hyj⟩) :
    ∃ E : cover u s ≃ₜ cover u t,
      ∀ i (hi : i ∈ u) x (hxi : x ∈ s i),
        (E ⟨x, subset_cover hi hxi⟩ : Y) = e i ⟨x, hxi⟩ := by
  classical
  induction u using Finset.induction_on with
  | empty =>
      letI : IsEmpty (cover ∅ s) :=
        ⟨fun x ↦ by simpa [cover] using x.2⟩
      letI : IsEmpty (cover ∅ t) :=
        ⟨fun y ↦ by simpa [cover] using y.2⟩
      refine ⟨Homeomorph.empty, ?_⟩
      intro i hi
      simp at hi
  | @insert a u ha ih =>
      have hs_u : ∀ i ∈ u, IsClosed (s i) := fun i hi ↦ hs i (Finset.mem_insert_of_mem hi)
      have ht_u : ∀ i ∈ u, IsClosed (t i) := fun i hi ↦ ht i (Finset.mem_insert_of_mem hi)
      have hf_u : ∀ i ∈ u, ∀ j ∈ u, ∀ x (hxi : x ∈ s i) (hxj : x ∈ s j),
          (e i ⟨x, hxi⟩ : Y) = e j ⟨x, hxj⟩ := by
        intro i hi j hj
        exact hforward i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj)
      have hb_u : ∀ i ∈ u, ∀ j ∈ u, ∀ y (hyi : y ∈ t i) (hyj : y ∈ t j),
          ((e i).symm ⟨y, hyi⟩ : X) = (e j).symm ⟨y, hyj⟩ := by
        intro i hi j hj
        exact hbackward i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj)
      obtain ⟨E, hE⟩ := ih hs_u ht_u hf_u hb_u
      have hsource_old : IsClosed (cover u s) := isClosed_cover hs_u
      have htarget_old : IsClosed (cover u t) := isClosed_cover ht_u
      have hforward_old_new : ∀ x (hxold : x ∈ cover u s) (hxa : x ∈ s a),
          (E ⟨x, hxold⟩ : Y) = e a ⟨x, hxa⟩ := by
        intro x hxold hxa
        obtain ⟨i, hi, hxi⟩ := mem_cover_iff.mp hxold
        rw [hE i hi x hxi]
        exact hforward i (Finset.mem_insert_of_mem hi) a (Finset.mem_insert_self a u)
          x hxi hxa
      have hbackward_old_new : ∀ y (hyold : y ∈ cover u t) (hya : y ∈ t a),
          (E.symm ⟨y, hyold⟩ : X) = (e a).symm ⟨y, hya⟩ := by
        intro y hyold hya
        obtain ⟨i, hi, hyi⟩ := mem_cover_iff.mp hyold
        have hpre : (E.symm ⟨y, hyold⟩ : X) = (e i).symm ⟨y, hyi⟩ := by
          have hmem : ((e i).symm ⟨y, hyi⟩ : X) ∈ cover u s :=
            subset_cover hi ((e i).symm ⟨y, hyi⟩).2
          have hmap : E ⟨(e i).symm ⟨y, hyi⟩, hmem⟩ = ⟨y, hyold⟩ := by
            apply Subtype.ext
            rw [hE i hi]
            exact congrArg Subtype.val ((e i).apply_symm_apply ⟨y, hyi⟩)
          rw [← hmap, E.symm_apply_apply]
        rw [hpre]
        exact hbackward i (Finset.mem_insert_of_mem hi) a (Finset.mem_insert_self a u)
          y hyi hya
      let G : (cover u s ∪ s a : Set X) ≃ₜ (cover u t ∪ t a : Set Y) :=
        ClosedCoverHomeomorph.glue hsource_old (hs a (Finset.mem_insert_self a u))
          htarget_old (ht a (Finset.mem_insert_self a u)) E (e a)
          hforward_old_new hbackward_old_new
      let E' : cover (insert a u) s ≃ₜ cover (insert a u) t :=
        (Homeomorph.setCongr (cover_insert a u s)).trans
          (G.trans (Homeomorph.setCongr (cover_insert a u t).symm))
      refine ⟨E', ?_⟩
      intro i hi x hxi
      rcases Finset.mem_insert.mp hi with rfl | hi
      · change (G ⟨x, Or.inr hxi⟩ : Y) = e i ⟨x, hxi⟩
        exact ClosedCoverHomeomorph.coe_glue_apply_of_mem_right
          hsource_old (hs i (Finset.mem_insert_self i u))
          htarget_old (ht i (Finset.mem_insert_self i u)) E (e i)
          hforward_old_new hbackward_old_new _ hxi
      · have hxold : x ∈ cover u s := subset_cover hi hxi
        change (G ⟨x, Or.inl hxold⟩ : Y) = e i ⟨x, hxi⟩
        rw [ClosedCoverHomeomorph.coe_glue_apply_of_mem_left
          hsource_old (hs a (Finset.mem_insert_self a u))
          htarget_old (ht a (Finset.mem_insert_self a u)) E (e a)
          hforward_old_new hbackward_old_new _ hxold]
        exact hE i hi x hxi

/-- A chosen finite closed-cover gluing homeomorphism. -/
noncomputable def glue
    (u : Finset ι)
    (s : ι → Set X) (t : ι → Set Y)
    (hs : ∀ i ∈ u, IsClosed (s i))
    (ht : ∀ i ∈ u, IsClosed (t i))
    (e : ∀ i, s i ≃ₜ t i)
    (hforward : ∀ i ∈ u, ∀ j ∈ u, ∀ x (hxi : x ∈ s i) (hxj : x ∈ s j),
      (e i ⟨x, hxi⟩ : Y) = e j ⟨x, hxj⟩)
    (hbackward : ∀ i ∈ u, ∀ j ∈ u, ∀ y (hyi : y ∈ t i) (hyj : y ∈ t j),
      ((e i).symm ⟨y, hyi⟩ : X) = (e j).symm ⟨y, hyj⟩) :
    cover u s ≃ₜ cover u t :=
  Classical.choose (exists_glue u s t hs ht e hforward hbackward)

theorem coe_glue_apply
    (u : Finset ι)
    (s : ι → Set X) (t : ι → Set Y)
    (hs : ∀ i ∈ u, IsClosed (s i))
    (ht : ∀ i ∈ u, IsClosed (t i))
    (e : ∀ i, s i ≃ₜ t i)
    (hforward : ∀ i ∈ u, ∀ j ∈ u, ∀ x (hxi : x ∈ s i) (hxj : x ∈ s j),
      (e i ⟨x, hxi⟩ : Y) = e j ⟨x, hxj⟩)
    (hbackward : ∀ i ∈ u, ∀ j ∈ u, ∀ y (hyi : y ∈ t i) (hyj : y ∈ t j),
      ((e i).symm ⟨y, hyi⟩ : X) = (e j).symm ⟨y, hyj⟩)
    (i : ι) (hi : i ∈ u) (x : X) (hxi : x ∈ s i) :
    (glue u s t hs ht e hforward hbackward ⟨x, subset_cover hi hxi⟩ : Y) =
      e i ⟨x, hxi⟩ :=
  (Classical.choose_spec (exists_glue u s t hs ht e hforward hbackward))
    i hi x hxi

theorem coe_glue_symm_apply
    (u : Finset ι)
    (s : ι → Set X) (t : ι → Set Y)
    (hs : ∀ i ∈ u, IsClosed (s i))
    (ht : ∀ i ∈ u, IsClosed (t i))
    (e : ∀ i, s i ≃ₜ t i)
    (hforward : ∀ i ∈ u, ∀ j ∈ u, ∀ x (hxi : x ∈ s i) (hxj : x ∈ s j),
      (e i ⟨x, hxi⟩ : Y) = e j ⟨x, hxj⟩)
    (hbackward : ∀ i ∈ u, ∀ j ∈ u, ∀ y (hyi : y ∈ t i) (hyj : y ∈ t j),
      ((e i).symm ⟨y, hyi⟩ : X) = (e j).symm ⟨y, hyj⟩)
    (i : ι) (hi : i ∈ u) (y : Y) (hyi : y ∈ t i) :
    ((glue u s t hs ht e hforward hbackward).symm
        ⟨y, subset_cover hi hyi⟩ : X) =
      (e i).symm ⟨y, hyi⟩ := by
  let E := glue u s t hs ht e hforward hbackward
  have hx : ((e i).symm ⟨y, hyi⟩ : X) ∈ cover u s :=
    subset_cover hi ((e i).symm ⟨y, hyi⟩).2
  have hmap : E ⟨(e i).symm ⟨y, hyi⟩, hx⟩ =
      ⟨y, subset_cover hi hyi⟩ := by
    apply Subtype.ext
    rw [coe_glue_apply u s t hs ht e hforward hbackward i hi]
    exact congrArg Subtype.val ((e i).apply_symm_apply ⟨y, hyi⟩)
  rw [← hmap, E.symm_apply_apply]

end FiniteClosedCoverHomeomorph

end

end Schoenflies
