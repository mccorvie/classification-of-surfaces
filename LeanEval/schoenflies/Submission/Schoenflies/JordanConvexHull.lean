/-!
# Jordan regions lie in the convex hulls of their curves

A point outside the convex hull of a Jordan carrier is separated from the
hull by a hyperplane, and the open half-plane on its side is an unbounded
connected set avoiding the curve; hence the point lies in the unbounded
complementary component.  Consequently the closed inside region has diameter
at most the diameter of the curve itself.  This converts pointwise boundary
tracking into diameter control of entire Jordan regions.
-/

namespace Schoenflies

open Metric Set

namespace JordanCircle

variable (J : JordanCircle)

/-- The bounded complementary region lies in the closed convex hull of the
curve. -/
theorem inside_subset_closedConvexHull_carrier :
    J.inside ⊆ closedConvexHull ℝ J.carrier := by
  intro z hz
  by_contra hzHull
  have hcarrierCompact : IsCompact J.carrier := isCompact_range J.continuous
  have hhullClosed : IsClosed (closedConvexHull ℝ J.carrier) :=
    isClosed_closedConvexHull
  obtain ⟨f, c, hfz, hfhull⟩ :=
    geometric_hahn_banach_point_closed
      convex_closedConvexHull hhullClosed hzHull
  set U : Set Plane := f ⁻¹' Iio c with hU_def
  have hzU : z ∈ U := hfz
  have hUopen : IsOpen U := isOpen_Iio.preimage f.continuous
  have hUconvex : Convex ℝ U := (convex_Iio c).linear_preimage f.toLinearMap
  have hUavoid : U ⊆ J.carrierᶜ := by
    intro w hw hwc
    exact lt_asymm hw (hfhull w (subset_closedConvexHull hwc))
  have hUcomponent : U ⊆ connectedComponentIn J.carrierᶜ z :=
    hUconvex.isPreconnected.subset_connectedComponentIn hzU hUavoid
  have hcomponent : connectedComponentIn J.carrierᶜ z = J.inside := by
    have hzc : z ∈ J.carrierᶜ := J.inside_subset_compl hz
    calc connectedComponentIn J.carrierᶜ z =
        connectedComponentIn J.carrierᶜ J.insidePoint := by
          exact (connectedComponentIn_eq hz).symm
      _ = J.inside := rfl
  have hUinside : U ⊆ J.inside := hcomponent ▸ hUcomponent
  -- but the half-plane is unbounded while the inside is bounded
  have hfne : f ≠ 0 := by
    intro h0
    obtain ⟨p, hp⟩ : (sphere (0 : Plane) 1).Nonempty :=
      NormedSpace.sphere_nonempty.mpr zero_le_one
    let w : Plane := J.parametrization ⟨p, hp⟩
    have hw : w ∈ J.carrier := ⟨⟨p, hp⟩, rfl⟩
    have := hfhull w (subset_closedConvexHull hw)
    rw [h0] at hfz this
    simp only [zero_apply] at hfz this
    exact lt_asymm hfz this
  obtain ⟨v, hv⟩ : ∃ v : Plane, f v ≠ 0 := by
    by_contra hall
    push Not at hall
    exact hfne (ContinuousLinearMap.ext fun w => by
      rw [hall w, zero_apply])
  have hUunbounded : ¬ Bornology.IsBounded U := by
    intro hbounded
    obtain ⟨R, hR⟩ := hbounded.subset_closedBall (0 : Plane)
    let u : Plane := (f v)⁻¹ • v
    have hfu : f u = 1 := by
      simp only [u, map_smul, smul_eq_mul]
      exact inv_mul_cancel₀ hv
    have hune : u ≠ 0 := by
      intro hu
      rw [hu, map_zero] at hfu
      exact zero_ne_one hfu
    have hunorm : 0 < ‖u‖ := norm_pos_iff.mpr hune
    -- Travel along the ray on which `f` decreases, hence remains below `c`.
    set w : ℝ → Plane := fun t => z - t • u with hw_def
    have hfw : ∀ t : ℝ, f (w t) = f z - t := by
      intro t
      rw [hw_def]
      simp only [map_sub, map_smul, smul_eq_mul, hfu, mul_one]
    have hmem : ∀ t : ℝ, 0 ≤ t → w t ∈ U := by
      intro t ht
      rw [hU_def]
      change f (w t) < c
      rw [hfw]
      linarith
    let t : ℝ := (|R| + ‖z‖ + 1) / ‖u‖ + 1
    have htpos : 0 < t := by
      dsimp only [t]
      positivity
    have hwt := hR (hmem t htpos.le)
    rw [mem_closedBall, dist_zero_right] at hwt
    have hupper : ‖w t - z‖ ≤ ‖w t‖ + ‖z‖ := norm_sub_le _ _
    have hnorm : ‖w t - z‖ = t * ‖u‖ := by
      rw [hw_def]
      simp only [sub_sub_cancel_left, norm_neg, norm_smul,
        Real.norm_eq_abs, abs_of_pos htpos]
    have htcalc : t * ‖u‖ = |R| + ‖z‖ + 1 + ‖u‖ := by
      dsimp only [t]
      field_simp
    rw [hnorm, htcalc] at hupper
    nlinarith [le_abs_self R]
  exact hUunbounded (J.inside_bounded.subset hUinside)

/-- The closed inside region has diameter at most the curve diameter. -/
theorem diam_closure_inside_le :
    Metric.diam (closure J.inside) ≤ Metric.diam J.carrier := by
  have hsubset : closure J.inside ⊆ closedConvexHull ℝ J.carrier :=
    closure_minimal J.inside_subset_closedConvexHull_carrier
      isClosed_closedConvexHull
  have hbounded : Bornology.IsBounded (closedConvexHull ℝ J.carrier) := by
    rw [closedConvexHull_eq_closure_convexHull]
    exact (isBounded_convexHull.mpr
      (isCompact_range J.continuous).isBounded).closure
  calc Metric.diam (closure J.inside) ≤
      Metric.diam (closedConvexHull ℝ J.carrier) := by
        apply Metric.diam_mono hsubset
        exact hbounded
    _ = Metric.diam J.carrier := by
      rw [closedConvexHull_eq_closure_convexHull, Metric.diam_closure,
        convexHull_diam]

end JordanCircle

end Schoenflies
