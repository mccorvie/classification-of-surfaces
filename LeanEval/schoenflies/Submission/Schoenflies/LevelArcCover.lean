open Set

namespace JordanCircle
namespace InitialAngularArcs

variable {J : JordanCircle}

/-- The boundary arcs at every complete binary level cover the original
Jordan carrier. -/
theorem iUnion_levelArc_curveArcPlane (I : J.InitialAngularArcs) :
    ∀ n : ℕ,
      (⋃ a : LevelAddress n, (I.levelArc a).curveArcPlane) = J.carrier := by
  intro n
  induction n with
  | zero =>
      apply Set.Subset.antisymm
      · intro x hx
        obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hx
        exact (I.levelArc a).curveArcPlane_subset_carrier J hxa
      · intro x hx
        rw [← I.curveArcPlane_union] at hx
        rcases hx with hxFirst | hxSecond
        · apply Set.mem_iUnion.mpr
          refine ⟨(false, fun i => Fin.elim0 i), ?_⟩
          simpa [levelArc, rootArc, AccessibleAngularArc.descendant] using
            hxFirst
        · apply Set.mem_iUnion.mpr
          refine ⟨(true, fun i => Fin.elim0 i), ?_⟩
          simpa [levelArc, rootArc, AccessibleAngularArc.descendant] using
            hxSecond
  | succ n ih =>
      apply Set.Subset.antisymm
      · intro x hx
        obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hx
        exact (I.levelArc a).curveArcPlane_subset_carrier J hxa
      · intro x hx
        have hxLevel : x ∈
            ⋃ a : LevelAddress n, (I.levelArc a).curveArcPlane := by
          rw [ih]
          exact hx
        obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hxLevel
        rw [← (I.levelArc a).leftChild_union_rightChild_curveArcPlane] at hxa
        rcases hxa with hxLeft | hxRight
        · apply Set.mem_iUnion.mpr
          exact ⟨extendLevelAddress a false, by simpa using hxLeft⟩
        · apply Set.mem_iUnion.mpr
          exact ⟨extendLevelAddress a true, by simpa using hxRight⟩

end InitialAngularArcs
