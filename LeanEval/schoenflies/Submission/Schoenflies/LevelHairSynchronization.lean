    D.trimmedLeftPoint ∈ (I.levelLeftHair a).carrier :=
  (I.levelLeftHair a).shortenToOpen_carrier_subset
    Metric.isOpen_thickening
    (self_subset_thickening hepsilon _
      (I.levelArc a).left_mem_curveArcPlane)
    D.trimmedLeftPoint_mem

