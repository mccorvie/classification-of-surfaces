variable {J : JordanCircle} {I : J.InitialAngularArcs}

/-- Level endpoint hairs are literally selected from the same retained
finite family whenever their plane anchors agree. -/
theorem levelRightHair_carrier_eq_levelLeftHair_of_eq
    {n : ℕ} (a b : LevelAddress n)
    (hshared :
      (J.curvePoint (I.levelArc a).right : Plane) =
        (J.curvePoint (I.levelArc b).left : Plane)) :
    (I.levelRightHair a).carrier = (I.levelLeftHair b).carrier := by
  let ir : I.GenerationMark n :=
    ⟨(J.curvePoint (I.levelArc a).right : Plane),
      I.levelArc_right_mem_generationMarks a⟩
  let il : I.GenerationMark n :=
    ⟨(J.curvePoint (I.levelArc b).left : Plane),
      I.levelArc_left_mem_generationMarks b⟩
  have hir : ir = il := Subtype.ext hshared
  change ((I.generationInsideHairFamily n).hair ir).carrier =
    ((I.generationInsideHairFamily n).hair il).carrier
  rw [hir]

