/-- The target-cell union lies in the expected standard polygonal shell. -/
theorem iUnion_targetCell_subset_standardClosedShell
    (k : ℕ) (hk : 1 ≤ k) :
    (⋃ a : LevelAddress k, I.targetCell k a) ⊆
      PolygonalCircle.closedShell
        (StandardPolygonalCollars.disk (k + 1))
        (StandardPolygonalCollars.disk (k + 2)) := by
  apply Set.iUnion_subset
  intro a x hxCell
  let C : I.LocalizedCutFreeCellData k a :=
    I.localizedCutFreeCellData k a
  refine ⟨C.targetDisk_closedRegion_subset_outerDisk hk hxCell, ?_⟩
  intro hxInnerInterior
  have hxInnerClosed : x ∈
      (StandardPolygonalCollars.disk (k + 1)).closedRegion := by
    rw [(StandardPolygonalCollars.disk (k + 1)).closedRegion_eq_union]
    exact Or.inl hxInnerInterior
  have hxShared : x ∈ range C.targetAttachmentPresentation.shared := by
    rw [← C.targetAttachmentPresentation.base_inter_disk]
    exact ⟨hxInnerClosed, hxCell⟩
  have hxInnerCarrier : x ∈
      (StandardPolygonalCollars.disk (k + 1)).carrier := by
    rw [C.range_targetAttachmentPresentation_shared] at hxShared
    exact C.targetSeparator.innerFirst_range_subset hxShared
  exact Set.disjoint_left.mp
    (PolygonalCircle.carrier_disjoint_interiorRegion
      (StandardPolygonalCollars.disk (k + 1)))
    hxInnerCarrier hxInnerInterior

