    (fun a _ => I.targetCell_isClosed k a)
    (fun a => (I.localizedCutFreeCellData k a).cellHomeomorph)
    (fun a _ b _ x hxa hxb =>
      I.canonicalLocalizedCellHomeomorph_agree k hk a b hxa hxb)
    (fun a _ b _ y hya hyb =>
      I.canonicalLocalizedCellHomeomorph_symm_agree k hk a b hya hyb)

