  by_contra hne
  exact Set.disjoint_left.mp
    (I.disjoint_levelLeftHairs_of_ne a b hne)
    (I.levelLocalizedPolygonalBoundaryMark_mem_leftHair k a)
    (hab ▸ I.levelLocalizedPolygonalBoundaryMark_mem_leftHair k b)

