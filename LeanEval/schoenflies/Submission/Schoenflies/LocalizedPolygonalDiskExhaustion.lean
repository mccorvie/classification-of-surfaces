import Submission.Schoenflies.MarkedPolygonalDiskExhaustion
import Submission.Schoenflies.LevelArcCover

/-!
# Nested polygonal disks with localized boundary control

The metric exhaustion only records that a successor polygon is close to the
whole Jordan carrier.  For the first-form Schoenflies construction we need a
stronger, local statement: its boundary may be required to lie in an
arbitrary prescribed open neighborhood of the carrier.  This lets a finite
"necklace" of arc neighborhoods retain the cyclic boundary correspondence.

Nesting does not have to be recovered from the later collar cells.  Add to
the protected compact core every point of the closed Jordan disk outside the
chosen boundary neighborhood.  The exterior-facing boundary of a
polyhedral neighborhood of that core is then automatically contained in the
chosen open set.
-/

namespace Schoenflies

open Set
open LeanEval.Topology.ClassificationOfSurfaces.Moise

noncomputable section

namespace JordanCircle

variable (J : JordanCircle)

/-- The part of the closed Jordan disk forbidden to a boundary constrained
to the open set `V`. -/
def outsideBoundaryNeighborhood (V : Set Plane) : Set Plane :=
  closure J.inside \ V

theorem isCompact_outsideBoundaryNeighborhood {V : Set Plane}
    (hVopen : IsOpen V) :
    IsCompact (J.outsideBoundaryNeighborhood V) :=
  J.isCompact_closure_inside.diff hVopen

theorem outsideBoundaryNeighborhood_subset_inside {V : Set Plane}
    (hJV : J.carrier ⊆ V) :
    J.outsideBoundaryNeighborhood V ⊆ J.inside := by
  rintro x ⟨hxClosure, hxV⟩
  rw [J.closure_inside] at hxClosure
  rcases hxClosure with hxInside | hxCarrier
  · exact hxInside
  · exact False.elim (hxV (hJV hxCarrier))

/-- A strictly nested polygonal successor whose boundary is constrained to
an arbitrary open neighborhood of the Jordan carrier.  The successor can
simultaneously absorb any prescribed compact subset of the inside; in the
Chapter 9 application this compact set is the finite collection of retained
hair tips at the current subdivision level. -/
theorem exists_nestedPolygonalDisk_boundary_subset_open_containing_compact
    (P : PolygonalCircle) (hPinside : P.closedRegion ⊆ J.inside)
    (V : Set Plane) (hVopen : IsOpen V) (hJV : J.carrier ⊆ V)
    (K : Set Plane) (hKcompact : IsCompact K) (hKinside : K ⊆ J.inside) :
    ∃ Q : PolygonalCircle,
      P.closedRegion ⊆ Q.interiorRegion ∧
        K ⊆ Q.interiorRegion ∧
        J.outsideBoundaryNeighborhood V ⊆ Q.interiorRegion ∧
        Q.closedRegion ⊆ J.inside ∧
        Q.carrier ⊆ V := by
  let core : Set Plane :=
    (P.closedRegion ∪ K) ∪ J.outsideBoundaryNeighborhood V
  have hcoreCompact : IsCompact core :=
    (P.isCompact_closedRegion.union hKcompact).union
      (J.isCompact_outsideBoundaryNeighborhood hVopen)
  have hcoreNonempty : core.Nonempty := by
    refine ⟨P.vertex 0, Or.inl (Or.inl ?_)⟩
    rw [P.closedRegion_eq_union]
    exact Or.inr (P.vertex_mem_carrier 0)
  have hcoreInside : core ⊆ J.inside := by
    exact Set.union_subset (Set.union_subset hPinside hKinside)
      (J.outsideBoundaryNeighborhood_subset_inside hJV)
  obtain ⟨C, hcoreC, hCcompact, hCconnected, hCinside⟩ :=
    J.exists_compactConnected_superset_inside
      hcoreCompact hcoreNonempty hcoreInside
  obtain ⟨Q, hCInterior, hQinside, hQdisjoint⟩ :=
    J.exists_polygonalDiskNeighborhood_with_boundary_avoidance
      hCcompact hCconnected hCinside
  have hPInterior : P.closedRegion ⊆ Q.interiorRegion := by
    intro x hx
    exact hCInterior (hcoreC (Or.inl (Or.inl hx)))
  have hKInterior : K ⊆ Q.interiorRegion := by
    intro x hx
    exact hCInterior (hcoreC (Or.inl (Or.inr hx)))
  have hForbiddenInterior :
      J.outsideBoundaryNeighborhood V ⊆ Q.interiorRegion := by
    intro x hx
    exact hCInterior (hcoreC (Or.inr hx))
  have hQcarrierV : Q.carrier ⊆ V := by
    intro x hxCarrier
    by_contra hxV
    have hxClosed : x ∈ Q.closedRegion := by
      rw [Q.closedRegion_eq_union]
      exact Or.inr hxCarrier
    have hxInside : x ∈ J.inside := hQinside hxClosed
    have hxForbidden : x ∈ J.outsideBoundaryNeighborhood V :=
      ⟨subset_closure hxInside, hxV⟩
    have hxC : x ∈ C := hcoreC (Or.inr hxForbidden)
    exact Set.disjoint_left.mp hQdisjoint hxCarrier hxC
  exact ⟨Q, hPInterior, hKInterior, hForbiddenInterior,
    hQinside, hQcarrierV⟩

/-- The no-extra-mark specialization. -/
theorem exists_nestedPolygonalDisk_boundary_subset_open
    (P : PolygonalCircle) (hPinside : P.closedRegion ⊆ J.inside)
    (V : Set Plane) (hVopen : IsOpen V) (hJV : J.carrier ⊆ V) :
    ∃ Q : PolygonalCircle,
      P.closedRegion ⊆ Q.interiorRegion ∧
        Q.closedRegion ⊆ J.inside ∧
        Q.carrier ⊆ V := by
  obtain ⟨Q, hP, _hempty, _hforbidden, hQinside, hQV⟩ :=
    J.exists_nestedPolygonalDisk_boundary_subset_open_containing_compact
      P hPinside V hVopen hJV ∅ isCompact_empty (empty_subset J.inside)
  exact ⟨Q, hP, hQinside, hQV⟩

end JordanCircle

namespace JordanCircle.InitialAngularArcs

open Metric

variable {J : JordanCircle} (I : J.InitialAngularArcs)

/-- The open level necklace used to localize a polygonal successor.  The
piece assigned to an arc is kept away from every retained generation hair
not incident to that arc. -/
def levelBoundaryNeighborhood (n : ℕ) (epsilon : ℝ) : Set Plane :=
  ⋃ a : LevelAddress n,
    thickening epsilon (I.levelArc a).curveArcPlane ∩
      (I.nonEndpointHairCarrier a)ᶜ

theorem isOpen_levelBoundaryNeighborhood (n : ℕ) (epsilon : ℝ) :
    IsOpen (I.levelBoundaryNeighborhood n epsilon) := by
  apply isOpen_iUnion
  intro a
  exact Metric.isOpen_thickening.inter
    (I.isClosed_nonEndpointHairCarrier a).isOpen_compl

theorem carrier_subset_levelBoundaryNeighborhood (n : ℕ)
    {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    J.carrier ⊆ I.levelBoundaryNeighborhood n epsilon := by
  rw [← I.iUnion_levelArc_curveArcPlane n]
  intro x hx
  obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hx
  apply Set.mem_iUnion.mpr
  refine ⟨a, ?_⟩
  exact ⟨self_subset_thickening hepsilon _ hxa,
    I.curveArcPlane_subset_compl_nonEndpointHairCarrier a hxa⟩

theorem levelBoundaryNeighborhood_subset_thickening_carrier
    (n : ℕ) (epsilon : ℝ) :
    I.levelBoundaryNeighborhood n epsilon ⊆
      thickening epsilon J.carrier := by
  intro x hx
  obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hx
  have hxaThick := hxa.1
  rw [mem_thickening_iff] at hxaThick ⊢
  obtain ⟨q, hqArc, hxq⟩ := hxaThick
  exact ⟨q, (I.levelArc a).curveArcPlane_subset_carrier J hqArc, hxq⟩

/-- The localized marked successor at stage `k`: it contains the preceding
closed disk and all level-`k` retained hair tips, while its boundary stays in
the level necklace. -/
noncomputable def nextLocalizedMarkedPolygonalDisk (k : ℕ)
    (P : PolygonalCircle) (hPinside : P.closedRegion ⊆ J.inside) :
    PolygonalCircle :=
  Classical.choose <|
    J.exists_nestedPolygonalDisk_boundary_subset_open_containing_compact
      P hPinside
      (I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k))
      (I.isOpen_levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k))
      (I.carrier_subset_levelBoundaryNeighborhood k
        (polygonalDiskBoundaryScale_pos k))
      (I.levelLeftHairTips k) (I.isCompact_levelLeftHairTips k)
      (I.levelLeftHairTips_subset_inside k)

private theorem nextLocalizedMarkedPolygonalDisk_spec (k : ℕ)
    (P : PolygonalCircle) (hPinside : P.closedRegion ⊆ J.inside) :
    P.closedRegion ⊆
        (I.nextLocalizedMarkedPolygonalDisk k P hPinside).interiorRegion ∧
      I.levelLeftHairTips k ⊆
        (I.nextLocalizedMarkedPolygonalDisk k P hPinside).interiorRegion ∧
      J.outsideBoundaryNeighborhood
          (I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k)) ⊆
        (I.nextLocalizedMarkedPolygonalDisk k P hPinside).interiorRegion ∧
      (I.nextLocalizedMarkedPolygonalDisk k P hPinside).closedRegion ⊆
        J.inside ∧
      (I.nextLocalizedMarkedPolygonalDisk k P hPinside).carrier ⊆
        I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k) :=
  Classical.choose_spec <|
    J.exists_nestedPolygonalDisk_boundary_subset_open_containing_compact
      P hPinside
      (I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k))
      (I.isOpen_levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k))
      (I.carrier_subset_levelBoundaryNeighborhood k
        (polygonalDiskBoundaryScale_pos k))
      (I.levelLeftHairTips k) (I.isCompact_levelLeftHairTips k)
      (I.levelLeftHairTips_subset_inside k)

theorem closedRegion_subset_interior_nextLocalizedMarkedPolygonalDisk
    (k : ℕ) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside) :
    P.closedRegion ⊆
      (I.nextLocalizedMarkedPolygonalDisk k P hPinside).interiorRegion :=
  (I.nextLocalizedMarkedPolygonalDisk_spec k P hPinside).1

theorem levelLeftHairTips_subset_interior_nextLocalizedMarkedPolygonalDisk
    (k : ℕ) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside) :
    I.levelLeftHairTips k ⊆
      (I.nextLocalizedMarkedPolygonalDisk k P hPinside).interiorRegion :=
  (I.nextLocalizedMarkedPolygonalDisk_spec k P hPinside).2.1

theorem outsideBoundaryNeighborhood_subset_interior_nextLocalizedMarkedPolygonalDisk
    (k : ℕ) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside) :
    J.outsideBoundaryNeighborhood
        (I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k)) ⊆
      (I.nextLocalizedMarkedPolygonalDisk k P hPinside).interiorRegion :=
  (I.nextLocalizedMarkedPolygonalDisk_spec k P hPinside).2.2.1

theorem nextLocalizedMarkedPolygonalDisk_closedRegion_subset_inside
    (k : ℕ) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside) :
    (I.nextLocalizedMarkedPolygonalDisk k P hPinside).closedRegion ⊆
      J.inside :=
  (I.nextLocalizedMarkedPolygonalDisk_spec k P hPinside).2.2.2.1

theorem nextLocalizedMarkedPolygonalDisk_carrier_subset_neighborhood
    (k : ℕ) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside) :
    (I.nextLocalizedMarkedPolygonalDisk k P hPinside).carrier ⊆
      I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k) :=
  (I.nextLocalizedMarkedPolygonalDisk_spec k P hPinside).2.2.2.2

theorem nextLocalizedMarkedPolygonalDisk_carrier_subset_thickening
    (k : ℕ) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside) :
    (I.nextLocalizedMarkedPolygonalDisk k P hPinside).carrier ⊆
      thickening (polygonalDiskBoundaryScale k) J.carrier :=
  (I.nextLocalizedMarkedPolygonalDisk_carrier_subset_neighborhood
      k P hPinside).trans
    (I.levelBoundaryNeighborhood_subset_thickening_carrier k
      (polygonalDiskBoundaryScale k))

/-- The recursively selected localized marked exhaustion. -/
noncomputable def localizedMarkedPolygonalDiskStage
    (I : J.InitialAngularArcs) :
    ℕ → J.InsidePolygonalDisk
  | 0 => ⟨J.initialPolygonalDisk,
      J.initialPolygonalDisk_closedRegion_subset_inside⟩
  | k + 1 =>
      let P : J.InsidePolygonalDisk := localizedMarkedPolygonalDiskStage I k
      ⟨I.nextLocalizedMarkedPolygonalDisk k P.1 P.2,
        I.nextLocalizedMarkedPolygonalDisk_closedRegion_subset_inside k P.1 P.2⟩

noncomputable def localizedMarkedPolygonalDisk (k : ℕ) : PolygonalCircle :=
  (I.localizedMarkedPolygonalDiskStage k).1

theorem localizedMarkedPolygonalDisk_closedRegion_subset_inside (k : ℕ) :
    (I.localizedMarkedPolygonalDisk k).closedRegion ⊆ J.inside :=
  (I.localizedMarkedPolygonalDiskStage k).2

@[simp] theorem localizedMarkedPolygonalDisk_zero :
    I.localizedMarkedPolygonalDisk 0 = J.initialPolygonalDisk := rfl

@[simp] theorem localizedMarkedPolygonalDisk_succ (k : ℕ) :
    I.localizedMarkedPolygonalDisk (k + 1) =
      I.nextLocalizedMarkedPolygonalDisk k
        (I.localizedMarkedPolygonalDisk k)
        (I.localizedMarkedPolygonalDisk_closedRegion_subset_inside k) := rfl

theorem localizedMarkedPolygonalDisk_strictly_nested (k : ℕ) :
    (I.localizedMarkedPolygonalDisk k).closedRegion ⊆
      (I.localizedMarkedPolygonalDisk (k + 1)).interiorRegion := by
  rw [I.localizedMarkedPolygonalDisk_succ k]
  exact I.closedRegion_subset_interior_nextLocalizedMarkedPolygonalDisk k _ _

theorem levelLeftHairTips_subset_localizedMarkedPolygonalDisk_succ (k : ℕ) :
    I.levelLeftHairTips k ⊆
      (I.localizedMarkedPolygonalDisk (k + 1)).interiorRegion := by
  rw [I.localizedMarkedPolygonalDisk_succ k]
  exact I.levelLeftHairTips_subset_interior_nextLocalizedMarkedPolygonalDisk k _ _

theorem localizedMarkedPolygonalDisk_succ_carrier_subset_neighborhood
    (k : ℕ) :
    (I.localizedMarkedPolygonalDisk (k + 1)).carrier ⊆
      I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k) := by
  rw [I.localizedMarkedPolygonalDisk_succ k]
  exact I.nextLocalizedMarkedPolygonalDisk_carrier_subset_neighborhood k _ _

theorem localizedMarkedPolygonalDisk_succ_carrier_subset_thickening
    (k : ℕ) :
    (I.localizedMarkedPolygonalDisk (k + 1)).carrier ⊆
      thickening (polygonalDiskBoundaryScale k) J.carrier :=
  (I.localizedMarkedPolygonalDisk_succ_carrier_subset_neighborhood k).trans
    (I.levelBoundaryNeighborhood_subset_thickening_carrier k
      (polygonalDiskBoundaryScale k))

/-- Every inside point is eventually in every later localized disk. -/
theorem eventually_mem_localizedMarkedPolygonalDisk_interior
    {x : Plane} (hx : x ∈ J.inside) :
    ∃ N : ℕ, ∀ k : ℕ, N ≤ k →
      x ∈ (I.localizedMarkedPolygonalDisk (k + 1)).interiorRegion := by
  obtain ⟨epsilon, hepsilon, hball⟩ :=
    (Metric.isOpen_iff.mp J.inside_isOpen) x hx
  have hxNotNear : x ∉ thickening (epsilon / 2) J.carrier := by
    intro hxNear
    rw [Metric.mem_thickening_iff] at hxNear
    obtain ⟨q, hqCarrier, hxq⟩ := hxNear
    have hqBall : q ∈ ball x epsilon := by
      rw [Metric.mem_ball, dist_comm]
      nlinarith
    exact J.inside_subset_compl (hball hqBall) hqCarrier
  obtain ⟨N, hN⟩ := exists_nat_one_div_lt (half_pos hepsilon)
  refine ⟨N, ?_⟩
  intro k hk
  have hscale : polygonalDiskBoundaryScale k ≤ epsilon / 2 := by
    have hmono : polygonalDiskBoundaryScale k ≤
        polygonalDiskBoundaryScale N := by
      unfold polygonalDiskBoundaryScale
      apply (inv_le_inv₀ (by positivity) (by positivity)).mpr
      exact_mod_cast Nat.add_le_add_right hk 1
    have hsmall : polygonalDiskBoundaryScale N < epsilon / 2 := by
      simpa [polygonalDiskBoundaryScale, one_div] using hN
    exact hmono.trans hsmall.le
  have hxNotV : x ∉
      I.levelBoundaryNeighborhood k (polygonalDiskBoundaryScale k) := by
    intro hxV
    apply hxNotNear
    exact thickening_mono hscale J.carrier
      (I.levelBoundaryNeighborhood_subset_thickening_carrier k
        (polygonalDiskBoundaryScale k) hxV)
  rw [I.localizedMarkedPolygonalDisk_succ k]
  apply I.outsideBoundaryNeighborhood_subset_interior_nextLocalizedMarkedPolygonalDisk
  exact ⟨subset_closure hx, hxNotV⟩

end JordanCircle.InitialAngularArcs

end

end Schoenflies
