/-- Closed-cover gluing before either finite union is given its geometric
shell name. -/
noncomputable def markedMoiseCellFiniteCoverHomeomorph
    (m : ℕ)
    (houtward : ∀ c : LevelAddress n,
      (F.synchronizedPolygonalCircle hn).closedRegion ∩
          (L.moiseBandPolygonalCircle c).closedRegion =
        range (F.synchronizedCrosscutPath c)) :
    FiniteClosedCoverHomeomorph.cover
        (Finset.univ : Finset (LevelAddress n)) L.sourceCell ≃ₜ
      FiniteClosedCoverHomeomorph.cover
        (Finset.univ : Finset (LevelAddress n)) (L.targetCell m) :=
  FiniteClosedCoverHomeomorph.glue
    Finset.univ L.sourceCell (L.targetCell m)
    (fun a _ => L.sourceCell_isClosed a)
    (fun a _ => L.targetCell_isClosed m a)
    (fun a => L.markedMoiseCellHomeomorph m a)
    (fun a _ b _ _ hxa hxb =>
      L.markedMoiseCellHomeomorph_agree m houtward a b hxa hxb)
    (fun a _ b _ _ hya hyb =>
      L.markedMoiseCellHomeomorph_symm_agree m a b hya hyb)

/-- The glued map with both sides written as ordinary indexed unions. -/
noncomputable def markedMoiseCellUnionHomeomorph
    (m : ℕ)
