          (L.moiseBandPolygonalCircle c).closedRegion =
        range (F.synchronizedCrosscutPath c))
    (a : LevelAddress n) {x : Plane} (hx : x ∈ L.sourceCell a) :
    (L.markedMoiseCellUnionHomeomorph m houtward
        ⟨x, Set.mem_iUnion.mpr ⟨a, hx⟩⟩ : Plane) =
