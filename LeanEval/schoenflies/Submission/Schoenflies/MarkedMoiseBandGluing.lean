/-- One outward-oriented recursive Moise band, with all of its marked seams,
is homeomorphic to the full standard shell between two consecutive radial
polygonal circles. -/
noncomputable def markedMoiseBandHomeomorph
    (m : ℕ)
    (houtward : ∀ c : LevelAddress n,
      (F.synchronizedPolygonalCircle hn).closedRegion ∩
          (L.moiseBandPolygonalCircle c).closedRegion =
        range (F.synchronizedCrosscutPath c)) :
    PolygonalCircle.closedShell L.parentDisk L.childDisk ≃ₜ
      PolygonalCircle.closedShell (disk m) (disk (m + 1)) :=
  (L.markedMoiseBandToTargetCellUnionHomeomorph m houtward).trans <|
    Homeomorph.setCongr
      (I.iUnion_cyclicTargetCell_eq_standardClosedShell m hn)

/-- On every source cell, the full band homeomorphism is still the marked
cell map from which the finite gluing was constructed. -/
theorem markedMoiseBandHomeomorph_apply
    (m : ℕ)
    (houtward : ∀ c : LevelAddress n,
