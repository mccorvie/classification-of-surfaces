      (F.synchronizedPolygonalCircle hn).closedRegion ∩
          (L.moiseBandPolygonalCircle c).closedRegion =
        range (F.synchronizedCrosscutPath c)) :
    (⋃ a : LevelAddress n, L.sourceCell a) ≃ₜ
      (⋃ a : LevelAddress n, L.targetCell m a) :=
  (Homeomorph.setCongr L.finiteCover_moiseSourceCell_eq_iUnion.symm).trans <|
    (L.markedMoiseCellFiniteCoverHomeomorph m houtward).trans <|
      Homeomorph.setCongr (L.finiteCover_cyclicTargetCell_eq_iUnion m)

