variable {J : JordanCircle} {I : J.InitialAngularArcs}
  {n : ℕ} {epsilon : ℝ}
  {F : I.LevelAvoidingJoinFamily n epsilon} {hn : 1 ≤ n}
  (L : RecursiveInsideCollarStep.Later F hn)

private noncomputable abbrev childIndex
    (b : LevelAddress L.next.level) :
    Fin (levelAddressCount L.next.level) :=
  levelIndexOf L.next.level b

/-- Every child address selected for a band lies over its parent boundary
arc. -/
theorem levelArc_curveArcPlane_subset_parent_of_mem_addresses
    {a : LevelAddress n} {b : LevelAddress L.next.level}
    (hb : b ∈ L.addresses a) :
    (I.levelArc b).curveArcPlane ⊆ (I.levelArc a).curveArcPlane := by
  rw [addresses, List.mem_map] at hb
  obtain ⟨b₀, hb₀, rfl⟩ := hb
  rw [I.levelArc_cast L.parentLevel_add_depth]
  exact I.levelArc_curveArcPlane_subset_of_mem_descendantAddresses a b₀ hb₀

/-- If the parent return and every child return used by one Moise band cell
lie in a common closed ball, then the complete non-retracing polygonal
boundary of that cell lies in the same ball. -/
theorem moiseBandCarrier_subset_closedBall
    (a : LevelAddress n) {c : Plane} {rho : ℝ}
    (hparent : F.synchronizedReturnSet a ⊆ closedBall c rho)
    (hchildren : ∀ b ∈ L.addresses a,
      L.next.family.forgetObstacle.synchronizedReturnSet b ⊆
        closedBall c rho) :
    L.moiseBandCarrier a ⊆ closedBall c rho := by
  let G := L.next.family.forgetObstacle
  rw [moiseBandCarrier]
  intro x hx
  obtain ⟨j, hxj⟩ := Set.mem_iUnion.mp hx
  obtain ⟨hj, hxSegment⟩ := Set.mem_iUnion.mp hxj
  rw [moiseBandSegments, List.mem_append] at hj
  rcases hj with hjOpen | hjRight
  · rw [List.mem_append] at hjOpen
    rcases hjOpen with hjParentLeft | hjChild
    · rw [List.mem_append] at hjParentLeft
      rcases hjParentLeft with hjParent | hjLeft
      · obtain ⟨i, rfl⟩ := L.parent_index_of_mem_parentMoiseSegments hjParent
        change x ∈ segment ℝ (F.edgeFinish ⟨a, i⟩)
          (F.edgeStart ⟨a, i⟩) at hxSegment
        apply hparent
        apply Or.inl
        apply Or.inr
        apply F.range_synchronizedCrosscutPath_subset a
        apply F.edgeSegment_subset_crosscutRange ⟨a, i⟩
        simpa [LevelAvoidingJoinFamily.edgeSegment, segment_symm]
          using hxSegment
      · have hjEq : j = MoiseBandSegmentAddress.leftSide L := by
          simpa only [List.mem_singleton] using hjLeft
        subst j
        apply hparent
        apply Or.inl
        apply Or.inl
        exact L.rawLeftSide_subset_parentBaseSegment a hxSegment
    · rcases L.child_or_junction_with_addresses_of_mem
          (L.addresses_isChain a) hjChild with hraw | hjunction
      · obtain ⟨e, heMem, rfl⟩ := hraw
        change x ∈ segment ℝ (G.trimmedEdgeFinish e)
          (G.trimmedEdgeStart e) at hxSegment
        apply hchildren e.1 heMem
        apply Or.inl
        apply Or.inr
        apply Or.inl
        apply Or.inr
        apply G.trimmedEdgeSegment_subset_trimmedPathRange e
        simpa [LevelAvoidingJoinFamily.trimmedEdgeSegment, segment_symm]
          using hxSegment
      · obtain ⟨b, d, hbMem, hdMem, hbd, rfl⟩ := hjunction
        have hbRight : G.trimmedRightPoint (L.childIndex b) ∈
            G.synchronizedReturnSet b := by
          apply Or.inl
          apply Or.inr
          apply Or.inl
          apply Or.inr
          exact Path.source_mem_range (G.trimmedPath (L.childIndex b))
        have hdLeft : G.trimmedLeftPoint (L.childIndex d) ∈
            G.synchronizedReturnSet d := by
          apply Or.inl
          apply Or.inr
          apply Or.inl
          apply Or.inr
          exact Path.target_mem_range (G.trimmedPath (L.childIndex d))
        exact (convex_closedBall c rho).segment_subset
          (hchildren b hbMem hbRight) (hchildren d hdMem hdLeft) hxSegment
  · have hjEq : j = MoiseBandSegmentAddress.rightSide L := by
      simpa only [List.mem_singleton] using hjRight
    subst j
    apply hparent
    apply Or.inr
    simpa [segment_symm] using
      L.rawRightSide_subset_parentBaseSegment a hxSegment

/-- The bounded polygonal Moise cell inherits the same ball bound from its
boundary. -/
theorem moiseBandClosedRegion_subset_closedBall
    (a : LevelAddress n) {c : Plane} {rho : ℝ}
    (hparent : F.synchronizedReturnSet a ⊆ closedBall c rho)
    (hchildren : ∀ b ∈ L.addresses a,
      L.next.family.forgetObstacle.synchronizedReturnSet b ⊆
        closedBall c rho) :
    (L.moiseBandPolygonalCircle a).closedRegion ⊆ closedBall c rho := by
  apply (L.moiseBandPolygonalCircle a)
    |>.closedRegion_subset_closedBall_of_carrier_subset
  rw [L.moiseBandPolygonalCircle_carrier a]
  exact L.moiseBandCarrier_subset_closedBall a hparent hchildren

/-- A form adapted to the recursive construction.  The parent return and
parent auxiliary cell have radius `parentRadius`; each child return has
radius `childRadius` about its own boundary base.  Descendant-arc containment
then puts the whole band cell in the ball with the sum of those radii. -/
theorem moiseBandClosedRegion_subset_closedBall_add
    (a : LevelAddress n) {c : Plane}
    {parentRadius childRadius : ℝ} (hchildRadius : 0 ≤ childRadius)
    (hparentReturn : F.synchronizedReturnSet a ⊆
      closedBall c parentRadius)
    (hparentCell :
      closure (F.exactSynchronizedAuxiliaryJordanCircle a).inside ⊆
        closedBall c parentRadius)
    (hchildReturns : ∀ b ∈ L.addresses a,
      L.next.family.forgetObstacle.synchronizedReturnSet b ⊆
        ball (J.curvePoint (I.levelArc b).left : Plane) childRadius) :
    (L.moiseBandPolygonalCircle a).closedRegion ⊆
      closedBall c (parentRadius + childRadius) := by
  let G := L.next.family.forgetObstacle
  apply L.moiseBandClosedRegion_subset_closedBall a
  · exact hparentReturn.trans
      (closedBall_subset_closedBall (le_add_of_nonneg_right hchildRadius))
  · intro b hb x hx
    have hbaseArc : (J.curvePoint (I.levelArc b).left : Plane) ∈
        (I.levelArc a).curveArcPlane :=
      L.levelArc_curveArcPlane_subset_parent_of_mem_addresses hb
        (I.levelArc b).left_mem_curveArcPlane
    have hbaseCarrier : (J.curvePoint (I.levelArc b).left : Plane) ∈
        (F.exactSynchronizedAuxiliaryJordanCircle a).carrier := by
      rw [F.carrier_exactSynchronizedAuxiliaryJordanCircle a]
      exact Or.inl hbaseArc
    have hbaseClosure : (J.curvePoint (I.levelArc b).left : Plane) ∈
        closure (F.exactSynchronizedAuxiliaryJordanCircle a).inside := by
      rw [(F.exactSynchronizedAuxiliaryJordanCircle a).closure_inside]
      exact Or.inr hbaseCarrier
    have hbaseNear := hparentCell hbaseClosure
    have hxNear := hchildReturns b hb hx
    rw [mem_ball] at hxNear
    rw [mem_closedBall] at hbaseNear ⊢
    calc
      dist x c ≤
          dist x (J.curvePoint (I.levelArc b).left : Plane) +
            dist (J.curvePoint (I.levelArc b).left : Plane) c :=
        dist_triangle _ _ _
      _ ≤ parentRadius + childRadius := by linarith

end RecursiveInsideCollarStep.Later

namespace RecursiveInsideCollarStep

variable {J : JordanCircle} {I : J.InitialAngularArcs}
  {P : PolygonalCircle}

/-- Quantitative shrinking for every band after the initial collar.  If `T`
constructed the parent collar and `L` constructs the following collar, then
each intervening Moise cell has radius at most the sum of the two stored
quarter-buffer bounds. -/
theorem moiseBandClosedRegion_subset_closedBall
    (T : I.RecursiveInsideCollarStep P)
    (L : Later T.family.forgetObstacle T.one_le_level)
    (a : LevelAddress T.level) :
    (L.moiseBandPolygonalCircle a).closedRegion ⊆
      closedBall (J.curvePoint (I.levelArc a).left : Plane)
        (T.buffer / 4 + L.next.buffer / 4) := by
  apply L.moiseBandClosedRegion_subset_closedBall_add a
      (div_nonneg L.next.buffer_pos.le (by norm_num))
  · exact (T.return_near a).trans ball_subset_closedBall
  · exact T.cell_near a
  · intro b _hb
    exact L.next.return_near b

end RecursiveInsideCollarStep
