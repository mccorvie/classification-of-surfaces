/-!
# Orientation of polygonal disks inside a Jordan domain

The Chapter 9 collars are polygonal disks contained in the bounded component
of the original Jordan curve.  Consequently the original curve is on the
unbounded side of every such collar.  Recording this elementary nesting fact
once avoids repeatedly making an arbitrary connected-side choice later.
-/

namespace Schoenflies

open Set Function
open LeanEval.Topology.ClassificationOfSurfaces.Moise

noncomputable section

namespace JordanCircle

/-- The carrier of a parametrized Jordan circle is connected. -/
theorem isConnected_carrier (J : JordanCircle) : IsConnected J.carrier := by
  have hsphere : IsConnected (Metric.sphere (0 : Plane) 1) :=
    isConnected_sphere JordanCurve.one_lt_rank_plane 0 zero_le_one
  letI : ConnectedSpace (Metric.sphere (0 : Plane) 1) :=
    isConnected_iff_connectedSpace.mp hsphere
  simpa only [carrier] using isConnected_range J.continuous

/-- If a polygonal closed disk is contained in the bounded Jordan domain,
then the original Jordan curve lies on the polygon's unbounded side.

The only other connected-side alternative would put the original curve in
the polygonal interior.  Jordan-region monotonicity would then also put the
whole original inside there, contradicting the fact that the polygonal
carrier itself lies in that original inside. -/
theorem carrier_subset_polygonalExterior_of_closedRegion_subset_inside
    (J : JordanCircle) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside) :
    J.carrier ⊆ P.exteriorRegion := by
  have hPcarrierInside : P.carrier ⊆ J.inside := by
    intro x hx
    apply hPinside
    rw [P.closedRegion_eq_union]
    exact Or.inr hx
  have hcarrierDisjoint : Disjoint J.carrier P.carrier := by
    rw [Set.disjoint_left]
    intro x hxJ hxP
    exact J.inside_subset_compl (hPcarrierInside hxP) hxJ
  have hcarrierComplement : J.carrier ⊆ P.carrierᶜ := by
    intro x hxJ hxP
    exact Set.disjoint_left.mp hcarrierDisjoint hxJ hxP
  have hcarrierSides : J.carrier ⊆
      P.interiorRegion ∪ P.exteriorRegion := by
    rw [P.interior_union_exterior]
    exact hcarrierComplement
  rcases J.isConnected_carrier.isPreconnected.subset_or_subset
      P.isOpen_interiorRegion P.isOpen_exteriorRegion
      P.disjoint_interior_exterior hcarrierSides with
    hJinterior | hJexterior
  · exfalso
    have hJordanInsideSubset : J.inside ⊆ P.interiorRegion := by
      rw [← P.inside_toJordanCircle]
      apply P.toJordanCircle.inside_subset_inside_of_carrier_subset J
      intro x hxJ
      left
      rw [P.inside_toJordanCircle]
      exact hJinterior hxJ
    have hvCarrier : P.vertex 0 ∈ P.carrier := P.vertex_mem_carrier 0
    have hvInterior : P.vertex 0 ∈ P.interiorRegion :=
      hJordanInsideSubset (hPcarrierInside hvCarrier)
    have hvComplement : P.vertex 0 ∈ P.carrierᶜ := by
      rw [← P.interior_union_exterior]
      exact Or.inl hvInterior
    exact hvComplement hvCarrier
  · exact hJexterior

/-- A path from the original Jordan curve to the interior of a polygonal
disk contained in the Jordan domain must cross the polygonal carrier. -/
theorem path_range_inter_polygonalCarrier_nonempty
    (J : JordanCircle) (P : PolygonalCircle)
    (hPinside : P.closedRegion ⊆ J.inside)
    {p q : Plane} (f : Path p q)
    (hp : p ∈ J.carrier) (hq : q ∈ P.interiorRegion) :
    (range f ∩ P.carrier).Nonempty := by
  by_contra hmeet
  have havoid : ∀ t ∈ Icc (⊥ : unitInterval) ⊤,
      f t ∉ P.toJordanCircle.carrier := by
    intro t _ht htCarrier
    apply hmeet
    refine ⟨f t, ⟨⟨t, rfl⟩, ?_⟩⟩
    rwa [P.carrier_toJordanCircle] at htCarrier
  have hsides := P.toJordanCircle.interval_image_same_side
    f.continuous (show (⊥ : unitInterval) ≤ ⊤ from bot_le) havoid
  have hpExterior : p ∈ P.exteriorRegion :=
    J.carrier_subset_polygonalExterior_of_closedRegion_subset_inside
      P hPinside hp
  have hpOutside : f ⊥ ∈ P.toJordanCircle.outside := by
    rw [P.outside_toJordanCircle]
    rw [show (⊥ : unitInterval) = 0 by rfl, f.source]
    exact hpExterior
  have hqInside : f ⊤ ∈ P.toJordanCircle.inside := by
    rw [P.inside_toJordanCircle]
    rw [show (⊤ : unitInterval) = 1 by rfl, f.target]
    exact hq
  rcases hsides with hsides | hsides
  · exact Set.disjoint_left.mp P.toJordanCircle.inside_disjoint_outside
      hsides.1 hpOutside
  · exact Set.disjoint_left.mp P.toJordanCircle.inside_disjoint_outside
      hqInside hsides.2

end JordanCircle

end

