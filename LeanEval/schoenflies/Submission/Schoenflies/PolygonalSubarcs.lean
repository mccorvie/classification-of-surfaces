/-!
# Polygonal boundary subarcs as broken-line joins

The cyclic arcs cut out by a polygon's vertices are already finite broken
lines.  These small adapters let the Chapter 9 construction concatenate a
chosen separator subarc with pieces of the auxiliary return path and then use
the existing Chapter 6 loop-erasure theorem.
-/

namespace LeanEval.Topology.ClassificationOfSurfaces.Moise

open Set

namespace PolygonalCircle.ProperChord

/-- The forward boundary arc from vertex `0` to vertex `k` is a broken-line
join inside its own carrier. -/
theorem joinedByBrokenLine_forwardArc (J : PolygonalCircle) {k : ℕ}
    : JoinedByBrokenLine (forwardArc (J := J) k)
      (J.vertex 0) (J.vertex (k : ZMod J.n)) := by
  refine ⟨k, (fun i : Fin (k + 1) => J.vertex (i.val : ZMod J.n)), ?_, ?_, ?_⟩
  · simp only [Fin.val_zero, Nat.cast_zero]
  · simp only [Fin.val_last]
  · intro i
    intro x hx
    simp only [forwardArc, Set.mem_iUnion]
    refine ⟨⟨i.val, i.isLt⟩, ?_⟩
    simpa only [edgeSegment, Fin.val_castSucc, Fin.val_succ, Nat.cast_add,
      Nat.cast_one] using hx

/-- The complementary boundary arc from vertex `k` back to vertex `0` is a
broken-line join inside its own carrier. -/
theorem joinedByBrokenLine_backwardArc (J : PolygonalCircle) {k : ℕ}
    (hkpos : k < J.n) :
    JoinedByBrokenLine (backwardArc (J := J) k)
      (J.vertex (k : ZMod J.n)) (J.vertex 0) := by
  have h := joinedByBrokenLine_forwardArc
    (J := J.rotate (k : ZMod J.n)) (k := J.n - k)
  change JoinedByBrokenLine
    (forwardArc (J := J.rotate (k : ZMod J.n)) (J.n - k))
      (J.vertex (k : ZMod J.n)) (J.vertex 0)
  have hstart : (J.rotate (k : ZMod J.n)).vertex 0 =
      J.vertex (k : ZMod J.n) := by
    change J.vertex ((0 : ZMod J.n) + (k : ZMod J.n)) = J.vertex (k : ZMod J.n)
    rw [zero_add]
  have hend : (J.rotate (k : ZMod J.n)).vertex
      ((J.n - k : ℕ) : ZMod (J.rotate (k : ZMod J.n)).n) = J.vertex 0 := by
    change J.vertex (((J.n - k : ℕ) : ZMod J.n) + (k : ZMod J.n)) = J.vertex 0
    rw [← Nat.cast_add, Nat.sub_add_cancel hkpos.le, ZMod.natCast_self]
  rw [← hstart, ← hend]
  exact h

end PolygonalCircle.ProperChord

end LeanEval.Topology.ClassificationOfSurfaces.Moise
