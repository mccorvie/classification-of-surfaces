import Submission.Schoenflies.PolygonalSubpathExtraction

/-!
# Exact segment incidence for resolved polygonal arcs

The Chapter 6 resolver already places a loop-erased broken line in a finite
plane complex.  This file exposes the exact linear edge-incidence statements
needed to concatenate several such arcs into one polygonal circle.
-/

namespace LeanEval
namespace Topology
namespace ClassificationOfSurfaces
namespace Moise

open Set

namespace BrokenLineData

variable {U : Set Plane} (B : BrokenLineData U)

/-- A resolved path with different endpoints has at least one edge. -/
theorem resolvedWalk_length_pos_of_start_ne_finish
    (hne : B.start ≠ B.finish) : 0 < B.resolvedWalk.length := by
  by_contra h
  have hzero : B.resolvedWalk.length = 0 := Nat.eq_zero_of_not_pos h
  apply hne
  rw [← B.resolvedVertex_start, ← B.resolvedVertex_finish]
  apply congrArg B.resolvedVertex
  apply Fin.ext
  simp [hzero]

/-- Consecutive vertices of a nonconstant resolved path are different. -/
theorem resolvedVertex_castSucc_ne_succ
    (i : Fin B.resolvedWalk.length) :
    B.resolvedVertex i.castSucc ≠ B.resolvedVertex i.succ := by
  apply B.resolvedVertex_injective.ne
  intro h
  have hval := congrArg Fin.val h
  simp at hval

/-- Consecutive resolved edges meet exactly at their shared vertex. -/
theorem resolvedSegment_consecutive_inter
    (i : Fin B.resolvedWalk.length)
    (hi : i.val + 1 < B.resolvedWalk.length) :
    segment ℝ (B.resolvedVertex i.castSucc) (B.resolvedVertex i.succ) ∩
        segment ℝ
          (B.resolvedVertex
            (⟨i.val + 1, hi⟩ : Fin B.resolvedWalk.length).castSucc)
          (B.resolvedVertex
            (⟨i.val + 1, hi⟩ : Fin B.resolvedWalk.length).succ) =
      {B.resolvedVertex i.succ} := by
  exact B.resolvedSegment_inter_of_succ_eq i ⟨i.val + 1, hi⟩ rfl

/-- Resolved edges whose linear indices are neither equal nor consecutive
are disjoint. -/
theorem resolvedSegment_disjoint_of_not_close
    (i j : Fin B.resolvedWalk.length) (hij : i ≠ j)
    (hijSucc : i.val + 1 ≠ j.val)
    (hjiSucc : j.val + 1 ≠ i.val) :
    Disjoint
      (segment ℝ (B.resolvedVertex i.castSucc) (B.resolvedVertex i.succ))
      (segment ℝ (B.resolvedVertex j.castSucc)
        (B.resolvedVertex j.succ)) := by
  rw [Set.disjoint_left]
  intro x hxi hxj
  rcases B.resolvedSegment_indices_close i j hxi hxj with h | h | h
  · exact hij h
  · exact hijSucc h
  · exact hjiSucc h

/-- The global parameter of a point on resolved edge `i` lies between its
two integer endpoint parameters. -/
theorem resolvedGlobalParameter_mem_edgeIcc
    (i : Fin B.resolvedWalk.length) {x : Plane}
    (hx : x ∈ segment ℝ (B.resolvedVertex i.castSucc)
      (B.resolvedVertex i.succ)) :
    B.resolvedGlobalParameter x ∈ Icc (i.val : ℝ) (i.val + 1) := by
  rw [B.resolvedGlobalParameter_eq_on_edge i hx]
  have himage : B.resolvedEdgeGlobalParameter i x ∈
      segment ℝ
        (B.resolvedEdgeGlobalParameter i (B.resolvedVertex i.castSucc))
        (B.resolvedEdgeGlobalParameter i (B.resolvedVertex i.succ)) := by
    rw [← _root_.image_segment ℝ (B.resolvedEdgeGlobalParameter i)]
    exact ⟨x, hx, rfl⟩
  simpa [B.resolvedEdgeGlobalParameter_apply_left,
    B.resolvedEdgeGlobalParameter_apply_right,
    segment_eq_Icc] using himage

/-- The initial resolved vertex lies only on the first edge. -/
theorem resolvedVertex_zero_mem_segment_iff
    (i : Fin B.resolvedWalk.length) :
    B.resolvedVertex 0 ∈
        segment ℝ (B.resolvedVertex i.castSucc) (B.resolvedVertex i.succ) ↔
      i.val = 0 := by
  constructor
  · intro hmem
    have hbounds := B.resolvedGlobalParameter_mem_edgeIcc i hmem
    rw [B.resolvedGlobalParameter_start] at hbounds
    have hle : i.val ≤ 0 := by exact_mod_cast hbounds.1
    omega
  · intro hi
    have hieq : i.castSucc = (0 : Fin (B.resolvedWalk.length + 1)) :=
      Fin.ext hi
    rw [← hieq]
    exact left_mem_segment ℝ _ _

/-- The final resolved vertex lies only on the last edge. -/
theorem resolvedVertex_last_mem_segment_iff
    (i : Fin B.resolvedWalk.length) :
    B.resolvedVertex (Fin.last B.resolvedWalk.length) ∈
        segment ℝ (B.resolvedVertex i.castSucc) (B.resolvedVertex i.succ) ↔
      i.val + 1 = B.resolvedWalk.length := by
  constructor
  · intro hmem
    have hbounds := B.resolvedGlobalParameter_mem_edgeIcc i hmem
    rw [B.resolvedGlobalParameter_finish] at hbounds
    have hi := i.isLt
    have hle : B.resolvedWalk.length ≤ i.val + 1 := by
      exact_mod_cast hbounds.2
    omega
  · intro hi
    have hieq : i.succ = Fin.last B.resolvedWalk.length := by
      apply Fin.ext
      simpa using hi
    rw [← hieq]
    exact right_mem_segment ℝ _ _

end BrokenLineData
