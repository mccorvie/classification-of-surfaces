/-!
# Separator frames for an explicit inside return arc

The original Chapter 9 construction chose an arbitrary polygonal return arc.
For the recursive collar construction we must instead use the arc built from
the already retained access hairs.  This file states the common topological
and metric setup in terms of `InsideReturnArc`, so both choices use one API.
-/

namespace Schoenflies

open Metric Set Function
open LeanEval.Topology.ClassificationOfSurfaces.Moise

namespace JordanCircle
namespace AccessibleAngularArc
namespace InsideReturnArc

variable {J : JordanCircle} {A : J.AccessibleAngularArc}

/-- The selected boundary subarc and an explicit inside return arc meet only
at their common endpoints. -/
theorem range_toPath_inter_path (R : A.InsideReturnArc) :
    range A.toPath ∩ range R.path =
      {(J.curvePoint A.left : Plane), (J.curvePoint A.right : Plane)} := by
  ext x
  constructor
  · rintro ⟨hxA, hxReturn⟩
    have hxArc : x ∈ A.curveArcPlane := A.range_toPath.le hxA
    have hxCarrier : x ∈ J.carrier :=
      A.curveArcPlane_subset_carrier J hxArc
    rcases R.range_subset_insideCrosscutSet hxReturn with
      hxInside | hxEndpoints
    · exact False.elim (J.inside_subset_compl hxInside hxCarrier)
    · exact hxEndpoints
  · intro hx
    rcases hx with hleft | hright
    · have hx : x = (J.curvePoint A.left : Plane) := hleft
      subst x
      exact ⟨Path.source_mem_range A.toPath, Path.target_mem_range R.path⟩
    · have hx : x = (J.curvePoint A.right : Plane) :=
        mem_singleton_iff.mp hright
      subst x
      exact ⟨Path.target_mem_range A.toPath, Path.source_mem_range R.path⟩

/-- The auxiliary Jordan circle formed by the wild boundary arc and the
explicit polygonal return. -/
noncomputable def auxiliaryJordanCircle (R : A.InsideReturnArc) : JordanCircle :=
  TwoArcJordan.toJordanCircle A.toPath R.path A.toPath_injective
    R.path_injective R.range_toPath_inter_path

@[simp] theorem carrier_auxiliaryJordanCircle (R : A.InsideReturnArc) :
    R.auxiliaryJordanCircle.carrier = A.curveArcPlane ∪ range R.path := by
  rw [auxiliaryJordanCircle, TwoArcJordan.carrier_toJordanCircle,
    A.range_toPath]

/-- The auxiliary circle stays in the closed inside of the original Jordan
circle. -/
theorem carrier_auxiliaryJordanCircle_subset (R : A.InsideReturnArc) :
    R.auxiliaryJordanCircle.carrier ⊆ J.inside ∪ J.carrier := by
  rw [R.carrier_auxiliaryJordanCircle]
  apply union_subset
  · exact fun x hx => Or.inr (A.curveArcPlane_subset_carrier J hx)
  · intro x hx
    rcases R.range_subset_insideCrosscutSet hx with hxInside | hxEnds
    · exact Or.inl hxInside
    · rcases hxEnds with hleft | hright
      · simpa [hleft] using Or.inr (J.curvePoint A.left).2
      · have hright' : x = (J.curvePoint A.right : Plane) :=
          mem_singleton_iff.mp hright
        simpa [hright'] using Or.inr (J.curvePoint A.right).2

/-- The auxiliary disk cut off by the selected boundary arc lies in the
original inside. -/
theorem inside_auxiliaryJordanCircle_subset (R : A.InsideReturnArc) :
    R.auxiliaryJordanCircle.inside ⊆ J.inside :=
  J.inside_subset_inside_of_carrier_subset R.auxiliaryJordanCircle
    R.carrier_auxiliaryJordanCircle_subset

/-- Every non-endpoint parameter of an inside return arc lies in the open
inside of the original Jordan circle. -/
theorem path_mem_inside_of_pos_of_lt_one (R : A.InsideReturnArc)
    {u : unitInterval} (hu0 : (⊥ : unitInterval) < u)
    (hu1 : u < (⊤ : unitInterval)) : R.path u ∈ J.inside := by
  rcases R.range_subset_insideCrosscutSet ⟨u, rfl⟩ with huI | huEnds
  · exact huI
  · rcases huEnds with huLeft | huRight
    · have huOne : u = (⊤ : unitInterval) :=
        R.path_injective (huLeft.trans R.path.target.symm)
      exact False.elim (hu1.ne huOne)
    · have huRight' : R.path u = (J.curvePoint A.right : Plane) :=
        mem_singleton_iff.mp huRight
      have huZero : u = (⊥ : unitInterval) :=
        R.path_injective (huRight'.trans R.path.source.symm)
      exact False.elim (hu0.ne' huZero)

/-- Cut an explicit return path into small endpoint tails and a compact
interior middle, retaining exactly the data needed to choose a fine outer
polygonal frame. -/
theorem exists_path_cuts (R : A.InsideReturnArc)
    {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ s t : unitInterval,
      (0 : ℝ) < s ∧ (s : ℝ) < t ∧ (t : ℝ) < 1 ∧
      R.path '' Icc (0 : unitInterval) s ⊆
        thickening epsilon A.curveArcPlane ∧
      R.path '' Icc t (1 : unitInterval) ⊆
        thickening epsilon A.curveArcPlane ∧
      IsCompact (R.path '' Icc s t) ∧
      IsPreconnected (R.path '' Icc s t) ∧
      R.path '' Icc s t ⊆ J.inside ∧
      Disjoint (R.path '' Icc s t) A.curveArcPlane := by
  have huniform : UniformContinuous R.path :=
    CompactSpace.uniformContinuous_of_continuous R.path.continuous
  obtain ⟨delta, hdelta, hmod⟩ :=
    (Metric.uniformContinuous_iff.mp huniform) epsilon hepsilon
  let eta : ℝ := min (delta / 2) (1 / 4)
  have hetaPos : 0 < eta := by
    dsimp [eta]
    exact lt_min (half_pos hdelta) (by norm_num)
  have hetaDelta : eta < delta := by
    calc
      eta ≤ delta / 2 := min_le_left _ _
      _ < delta := half_lt_self hdelta
  have hetaHalf : eta < 1 / 2 := by
    calc
      eta ≤ 1 / 4 := min_le_right _ _
      _ < 1 / 2 := by norm_num
  let s : unitInterval :=
    ⟨eta, ⟨hetaPos.le, by linarith [hetaHalf]⟩⟩
  let t : unitInterval :=
    ⟨1 - eta, ⟨by linarith [hetaHalf], by linarith [hetaPos]⟩⟩
  have hfirst : R.path '' Icc (0 : unitInterval) s ⊆
      thickening epsilon A.curveArcPlane := by
    rintro x ⟨u, hu, rfl⟩
    have hdistDomain : dist u (0 : unitInterval) < delta := by
      change |(u : ℝ) - 0| < delta
      rw [sub_zero, abs_of_nonneg u.2.1]
      have huS : (u : ℝ) ≤ (s : ℝ) := hu.2
      have huEta : (u : ℝ) ≤ eta := by simpa [s] using huS
      exact huEta.trans_lt hetaDelta
    have hdistImage :
        dist (R.path u) (J.curvePoint A.right : Plane) < epsilon := by
      simpa only [R.path.source] using hmod hdistDomain
    exact ball_subset_thickening A.right_mem_curveArcPlane epsilon hdistImage
  have hlast : R.path '' Icc t (1 : unitInterval) ⊆
      thickening epsilon A.curveArcPlane := by
    rintro x ⟨u, hu, rfl⟩
    have hdistDomain : dist u (1 : unitInterval) < delta := by
      change |(u : ℝ) - 1| < delta
      rw [abs_of_nonpos (sub_nonpos.mpr u.2.2)]
      have htU : (t : ℝ) ≤ (u : ℝ) := hu.1
      have huEta : 1 - eta ≤ (u : ℝ) := by simpa [t] using htU
      linarith [huEta, hetaDelta]
    have hdistImage :
        dist (R.path u) (J.curvePoint A.left : Plane) < epsilon := by
      simpa only [R.path.target] using hmod hdistDomain
    exact ball_subset_thickening A.left_mem_curveArcPlane epsilon hdistImage
  have hst : s < t := by
    change eta < 1 - eta
    linarith [hetaHalf]
  have hmiddleInside : R.path '' Icc s t ⊆ J.inside := by
    rintro x ⟨u, hu, rfl⟩
    exact R.path_mem_inside_of_pos_of_lt_one
      (show (⊥ : unitInterval) < u from (by
        change (0 : ℝ) < (u : ℝ)
        exact hetaPos.trans_le hu.1))
      (show u < (⊤ : unitInterval) from (by
        change (u : ℝ) < 1
        have hut0 : (u : ℝ) ≤ (t : ℝ) := hu.2
        have hut : (u : ℝ) ≤ 1 - eta := by simpa [t] using hut0
        linarith))
  have hmiddleDisjoint : Disjoint (R.path '' Icc s t) A.curveArcPlane := by
    rw [Set.disjoint_left]
    intro x hxMiddle hxArc
    exact (J.inside_subset_compl (hmiddleInside hxMiddle))
      (A.curveArcPlane_subset_carrier J hxArc)
  refine ⟨s, t, by simpa [s], hst, by simpa [t], hfirst, hlast,
    isCompact_Icc.image R.path.continuous,
    ordConnected_Icc.isPreconnected.image R.path
      R.path.continuous.continuousOn,
    hmiddleInside, hmiddleDisjoint⟩

/-- If the frame contains the boundary arc and avoids the middle of an
explicit return, all auxiliary-circle intersections lie on its two tails. -/
theorem frame_inter_auxiliaryCarrier_subset_tails
    (R : A.InsideReturnArc) {s t : unitInterval} (P : PolygonalCircle)
    (hArcInside : A.curveArcPlane ⊆ P.interiorRegion)
    (hMiddleDisjoint : Disjoint (R.path '' Icc s t) P.carrier) :
    P.carrier ∩ R.auxiliaryJordanCircle.carrier ⊆
      R.path '' Icc (0 : unitInterval) s ∪
        R.path '' Icc t (1 : unitInterval) := by
  intro x hx
  rcases hx with ⟨hxP, hxAux⟩
  rw [R.carrier_auxiliaryJordanCircle] at hxAux
  rcases hxAux with hxArc | ⟨u, rfl⟩
  · have hxInside : x ∈ P.interiorRegion := hArcInside hxArc
    have hxCompl : x ∈ P.carrierᶜ := by
      rw [← P.interior_union_exterior]
      exact Or.inl hxInside
    exact False.elim (hxCompl hxP)
  · rcases le_total u s with hus | hsu
    · exact Or.inl ⟨u, ⟨bot_le, hus⟩, rfl⟩
    · rcases le_total u t with hut | htu
      · have huMiddle : R.path u ∈ R.path '' Icc s t :=
          ⟨u, ⟨hsu, hut⟩, rfl⟩
        exact False.elim
          (Set.disjoint_left.mp hMiddleDisjoint huMiddle hxP)
      · exact Or.inr ⟨u, ⟨htu, le_top⟩, rfl⟩

/-- A frame with the endpoint boundary points inside and the return middle
outside meets both endpoint tails. -/
theorem frame_meets_both_tails
    (R : A.InsideReturnArc) {s t : unitInterval}
    (P : PolygonalCircle) (hst : s ≤ t)
    (hArcInside : A.curveArcPlane ⊆ P.interiorRegion)
    (hMiddleExterior : R.path '' Icc s t ⊆ P.exteriorRegion) :
    (P.carrier ∩ R.path '' Icc (0 : unitInterval) s).Nonempty ∧
      (P.carrier ∩ R.path '' Icc t (1 : unitInterval)).Nonempty := by
  have hrightInside : R.path (0 : unitInterval) ∈ P.interiorRegion := by
    rw [R.path.source]
    exact hArcInside A.right_mem_curveArcPlane
  have hleftInside : R.path (1 : unitInterval) ∈ P.interiorRegion := by
    rw [R.path.target]
    exact hArcInside A.left_mem_curveArcPlane
  have hsExterior : R.path s ∈ P.exteriorRegion :=
    hMiddleExterior ⟨s, ⟨le_rfl, hst⟩, rfl⟩
  have htExterior : R.path t ∈ P.exteriorRegion :=
    hMiddleExterior ⟨t, ⟨hst, le_rfl⟩, rfl⟩
  constructor
  · let first : Set Plane := R.path '' Icc (0 : unitInterval) s
    by_contra hmeet
    have hdisjoint : Disjoint first P.carrier := by
      rw [Set.disjoint_left]
      intro x hxFirst hxP
      exact hmeet ⟨x, hxP, hxFirst⟩
    have hregions : first ⊆ P.interiorRegion ∪ P.exteriorRegion := by
      rw [P.interior_union_exterior]
      intro x hxFirst hxP
      exact Set.disjoint_left.mp hdisjoint hxFirst hxP
    have hpreconnected : IsPreconnected first :=
      ordConnected_Icc.isPreconnected.image R.path
        R.path.continuous.continuousOn
    rcases hpreconnected.subset_or_subset P.isOpen_interiorRegion
        P.isOpen_exteriorRegion P.disjoint_interior_exterior hregions with
      hInside | hOutside
    · have hsInside : R.path s ∈ P.interiorRegion :=
        hInside ⟨s, ⟨bot_le, le_rfl⟩, rfl⟩
      exact Set.disjoint_left.mp P.disjoint_interior_exterior
        hsInside hsExterior
    · have hzeroOutside : R.path (0 : unitInterval) ∈ P.exteriorRegion :=
        hOutside ⟨0, ⟨le_rfl, bot_le⟩, rfl⟩
      exact Set.disjoint_left.mp P.disjoint_interior_exterior
        hrightInside hzeroOutside
  · let last : Set Plane := R.path '' Icc t (1 : unitInterval)
    by_contra hmeet
    have hdisjoint : Disjoint last P.carrier := by
      rw [Set.disjoint_left]
      intro x hxLast hxP
      exact hmeet ⟨x, hxP, hxLast⟩
    have hregions : last ⊆ P.interiorRegion ∪ P.exteriorRegion := by
      rw [P.interior_union_exterior]
      intro x hxLast hxP
      exact Set.disjoint_left.mp hdisjoint hxLast hxP
    have hpreconnected : IsPreconnected last :=
      ordConnected_Icc.isPreconnected.image R.path
        R.path.continuous.continuousOn
    rcases hpreconnected.subset_or_subset P.isOpen_interiorRegion
        P.isOpen_exteriorRegion P.disjoint_interior_exterior hregions with
      hInside | hOutside
    · have htInside : R.path t ∈ P.interiorRegion :=
        hInside ⟨t, ⟨le_rfl, le_top⟩, rfl⟩
      exact Set.disjoint_left.mp P.disjoint_interior_exterior
        htInside htExterior
    · have honeOutside : R.path (1 : unitInterval) ∈ P.exteriorRegion :=
        hOutside ⟨1, ⟨le_top, le_rfl⟩, rfl⟩
      exact Set.disjoint_left.mp P.disjoint_interior_exterior
        hleftInside honeOutside

/-- The complete pre-separator frame for an explicit return arc. -/
theorem exists_separatorFrame (R : A.InsideReturnArc)
    {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ (s t : unitInterval) (rho : ℝ)
      (N : FinitePolyhedralNeighborhood A.curveArcPlane
        (thickening rho A.curveArcPlane))
      (P : PolygonalCircle),
      (0 : ℝ) < s ∧ (s : ℝ) < t ∧ (t : ℝ) < 1 ∧
      0 < rho ∧ rho ≤ epsilon ∧
      R.path '' Icc (0 : unitInterval) s ⊆
        thickening epsilon A.curveArcPlane ∧
      R.path '' Icc t (1 : unitInterval) ⊆
        thickening epsilon A.curveArcPlane ∧
      P.carrier ⊆ thickening rho A.curveArcPlane ∧
      A.curveArcPlane ⊆ P.interiorRegion ∧
      R.path '' Icc s t ⊆ P.exteriorRegion ∧
      IsCompact (R.path '' Icc s t) ∧
      IsPreconnected (R.path '' Icc s t) ∧
      Disjoint (R.path '' Icc s t) P.carrier ∧
      (P.carrier ∩ R.path '' Icc (0 : unitInterval) s).Nonempty ∧
      (P.carrier ∩ R.path '' Icc t (1 : unitInterval)).Nonempty ∧
      P.carrier ∩ R.auxiliaryJordanCircle.carrier ⊆
        R.path '' Icc (0 : unitInterval) s ∪
          R.path '' Icc t (1 : unitInterval) := by
  obtain ⟨s, t, hspos, hst, htone, hfirst, hlast,
      hmiddleCompact, hmiddlePreconnected, _hmiddleInside, hmiddleArc⟩ :=
    R.exists_path_cuts hepsilon
  let middle : Set Plane := R.path '' Icc s t
  obtain ⟨delta, hdelta, hmiddleThick⟩ :=
    A.exists_thickening_disjoint_of_compact hmiddleCompact hmiddleArc
  let eta : ℝ := min epsilon delta
  have heta : 0 < eta := lt_min hepsilon hdelta
  have hetaEpsilon : eta ≤ epsilon := min_le_left _ _
  have hetaDelta : eta ≤ delta := min_le_right _ _
  have hstLe : s ≤ t := hst.le
  have hsMiddle : R.path s ∈ middle := ⟨s, ⟨le_rfl, hstLe⟩, rfl⟩
  have hsNotArc : R.path s ∉ A.curveArcPlane := by
    intro hsArc
    exact Set.disjoint_left.mp hmiddleArc hsMiddle hsArc
  obtain ⟨rho, N, P, hrho, hrhoEta, hPthick,
      hArcInside, hsExterior⟩ :=
    A.exists_outerFrame_with_point_exterior heta hsNotArc
  have hrhoEpsilon : rho ≤ epsilon := hrhoEta.trans hetaEpsilon
  have hrhoDelta : rho ≤ delta := hrhoEta.trans hetaDelta
  have hmiddleP : Disjoint middle P.carrier := by
    apply hmiddleThick.mono_right
    exact hPthick.trans (thickening_mono hrhoDelta A.curveArcPlane)
  have hmiddleRegions : middle ⊆
      P.interiorRegion ∪ P.exteriorRegion := by
    rw [P.interior_union_exterior]
    intro x hxMiddle hxCarrier
    exact Set.disjoint_left.mp hmiddleP hxMiddle hxCarrier
  have hmiddleExterior : middle ⊆ P.exteriorRegion := by
    rcases hmiddlePreconnected.subset_or_subset P.isOpen_interiorRegion
        P.isOpen_exteriorRegion P.disjoint_interior_exterior hmiddleRegions with
      hInside | hOutside
    · have hsInside : R.path s ∈ P.interiorRegion := hInside hsMiddle
      exact False.elim
        (Set.disjoint_left.mp P.disjoint_interior_exterior hsInside hsExterior)
    · exact hOutside
  have hmeets := R.frame_meets_both_tails P hstLe hArcInside hmiddleExterior
  have hintersections :=
    R.frame_inter_auxiliaryCarrier_subset_tails P hArcInside hmiddleP
  exact ⟨s, t, rho, N, P, hspos, hst, htone, hrho, hrhoEpsilon,
    hfirst, hlast, hPthick, hArcInside, hmiddleExterior,
    hmiddleCompact, hmiddlePreconnected, hmiddleP,
    hmeets.1, hmeets.2, hintersections⟩

/-- Translate a fine frame into generic finite position relative to the
explicit finite return carrier. -/
theorem exists_finiteSeparatorFrame (R : A.InsideReturnArc)
    {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ (s t : unitInterval) (Q : PolygonalCircle),
      (0 : ℝ) < s ∧ (s : ℝ) < t ∧ (t : ℝ) < 1 ∧
      R.path '' Icc (0 : unitInterval) s ⊆
        thickening epsilon A.curveArcPlane ∧
      R.path '' Icc t (1 : unitInterval) ⊆
        thickening epsilon A.curveArcPlane ∧
      Q.carrier ⊆ thickening epsilon A.curveArcPlane ∧
      A.curveArcPlane ⊆ Q.interiorRegion ∧
      R.path '' Icc s t ⊆ Q.exteriorRegion ∧
      IsCompact (R.path '' Icc s t) ∧
      IsPreconnected (R.path '' Icc s t) ∧
      Disjoint (R.path '' Icc s t) Q.carrier ∧
      (Q.carrier ∩ range R.path).Finite ∧
      (Q.carrier ∩ R.path '' Icc (0 : unitInterval) s).Nonempty ∧
      (Q.carrier ∩ R.path '' Icc t (1 : unitInterval)).Nonempty ∧
      Q.carrier ∩ R.auxiliaryJordanCircle.carrier ⊆
        R.path '' Icc (0 : unitInterval) s ∪
          R.path '' Icc t (1 : unitInterval) ∧
      (∀ (i : ZMod Q.n) (j : Fin R.carrierBrokenLine.data.n),
        planeDet
          (R.carrierBrokenLine.data.vertex j.castSucc - Q.vertex i)
          (R.carrierBrokenLine.data.vertex j.succ -
            R.carrierBrokenLine.data.vertex j.castSucc) ≠ 0) ∧
      ∀ (i : ZMod Q.n)
          (j : Fin (R.carrierBrokenLine.data.n + 1)),
        planeDet
          (R.carrierBrokenLine.data.vertex j - Q.vertex i)
          (Q.vertex (i + 1) - Q.vertex i) ≠ 0 := by
  have hhalf : 0 < epsilon / 2 := half_pos hepsilon
  obtain ⟨s, t, rho, _N, P, hspos, hst, htone, _hrho,
      hrhoHalf, hfirst, hlast, hPthick, hArcInside,
      hMiddleExterior, hMiddleCompact, hMiddlePreconnected,
      _hMiddleDisjoint, _hFirstMeet, _hLastMeet, _hIntersections⟩ :=
    R.exists_separatorFrame hhalf
  let middle : Set Plane := R.path '' Icc s t
  obtain ⟨v, Q, hv, hQcarrier, hArcQ, hMiddleQ, hfiniteR,
      hgenericEdges, hgenericVertices⟩ :=
    R.carrierBrokenLine.exists_generic_translation P
      A.curveArcPlane_isCompact hMiddleCompact hArcInside
      hMiddleExterior hhalf
  have hQthick : Q.carrier ⊆ thickening epsilon A.curveArcPlane := by
    rw [hQcarrier]
    rintro x ⟨y, hyP, rfl⟩
    obtain ⟨z, hzArc, hyz⟩ := mem_thickening_iff.mp (hPthick hyP)
    apply mem_thickening_iff.mpr
    refine ⟨z, hzArc, ?_⟩
    have hvDist : dist (v + y) y < epsilon / 2 := by
      simpa [dist_eq_norm] using hv
    calc
      dist (v + y) z ≤ dist (v + y) y + dist y z := dist_triangle _ _ _
      _ < epsilon / 2 + epsilon / 2 :=
        add_lt_add hvDist (hyz.trans_le hrhoHalf)
      _ = epsilon := by ring
  have hMiddleDisjoint : Disjoint middle Q.carrier := by
    rw [Set.disjoint_left]
    intro x hxMiddle hxCarrier
    exact Set.disjoint_left.mp Q.disjoint_carrier_exteriorRegion
      hxCarrier (hMiddleQ hxMiddle)
  have hfinite : (Q.carrier ∩ range R.path).Finite := by
    rw [← R.segmentCarrier_carrierBrokenLine_eq_range]
    exact hfiniteR
  have hstLe : s ≤ t := hst.le
  have hmeets := R.frame_meets_both_tails Q hstLe hArcQ hMiddleQ
  have hintersections :=
    R.frame_inter_auxiliaryCarrier_subset_tails Q hArcQ hMiddleDisjoint
  exact ⟨s, t, Q, hspos, hst, htone,
    hfirst.trans (thickening_mono (half_le_self hepsilon.le) _),
    hlast.trans (thickening_mono (half_le_self hepsilon.le) _),
    hQthick, hArcQ, hMiddleQ, hMiddleCompact, hMiddlePreconnected,
    hMiddleDisjoint, hfinite, hmeets.1, hmeets.2, hintersections,
    hgenericEdges, hgenericVertices⟩

