import Submission.Schoenflies.PolygonalSubpathExtraction
import Submission.Schoenflies.ReturnArcFrames

/-!
# Jordan collar cells from trimmed prescribed-hair crosscuts

The crosscut selected for a level arc is first trimmed at its last contact
with the retained right hair and its first subsequent contact with the
retained left hair.  This file joins that finite middle line to the two
remaining hair segments, loop-erases the resulting finite chain, and packages
it as the explicit `InsideReturnArc` consumed by the generic auxiliary-Jordan
circle API.

This is the one-cell version of the collar in Moise 9.6.  The remaining
finite-level construction has to choose these cells compatibly for all arcs
of a subdivision level.
-/

namespace Schoenflies

open Metric Set Function
open LeanEval.Topology.ClassificationOfSurfaces.Moise

namespace JordanCircle
namespace InitialAngularArcs
namespace LevelInsideJoinData

variable {J : JordanCircle} {I : J.InitialAngularArcs} {n : ℕ}
  {a : LevelAddress n} {epsilon : ℝ} {hepsilon : 0 < epsilon}

/-- The finite three-piece carrier after trimming the middle crosscut at its
exact intersections with the retained endpoint hairs. -/
noncomputable def trimmedReturnSet
    (D : I.LevelInsideJoinData a epsilon hepsilon) : Set Plane :=
  segment ℝ (J.curvePoint (I.levelArc a).left) D.trimmedLeftPoint ∪
    D.trimmedLine.data.segmentCarrier ∪
    segment ℝ D.trimmedRightPoint
      (J.curvePoint (I.levelArc a).right)

/-- The three trimmed pieces form a finite chain from the left boundary
endpoint to the right boundary endpoint. -/
theorem joinedByBrokenLine_trimmedReturnSet
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    JoinedByBrokenLine D.trimmedReturnSet
      (J.curvePoint (I.levelArc a).left)
      (J.curvePoint (I.levelArc a).right) := by
  let B := D.trimmedLine
  have hleft : JoinedByBrokenLine D.trimmedReturnSet
      (J.curvePoint (I.levelArc a).left) D.trimmedLeftPoint := by
    apply JoinedByBrokenLine.of_segment
    intro x hx
    exact Or.inl (Or.inl hx)
  have hmiddleRightLeft : JoinedByBrokenLine D.trimmedReturnSet
      D.trimmedRightPoint D.trimmedLeftPoint := by
    refine ⟨B.data.n, B.data.vertex, B.start_eq, B.finish_eq, ?_⟩
    intro i x hx
    exact Or.inl (Or.inr (Set.mem_iUnion_of_mem i hx))
  have hright : JoinedByBrokenLine D.trimmedReturnSet
      D.trimmedRightPoint (J.curvePoint (I.levelArc a).right) := by
    apply JoinedByBrokenLine.of_segment
    intro x hx
    exact Or.inr hx
  exact (hleft.trans hmiddleRightLeft.symm).trans hright

/-- Loop erasure converts the finite three-piece chain into a simple
polygonal line with the same endpoint and carrier control. -/
noncomputable def trimmedReturnLine
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    SimpleBrokenLine D.trimmedReturnSet
      (J.curvePoint (I.levelArc a).left)
      (J.curvePoint (I.levelArc a).right) :=
  simpleBrokenLineOfJoined D.joinedByBrokenLine_trimmedReturnSet

/-- Orient the trimmed polygonal return from right to left so it closes the
wild level arc. -/
noncomputable def trimmedReturnPath
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    Path (J.curvePoint (I.levelArc a).right : Plane)
      (J.curvePoint (I.levelArc a).left : Plane) :=
  (D.trimmedReturnLine.toPath (I.levelArc a).endpoint_ne).symm

theorem trimmedReturnPath_injective
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    Injective D.trimmedReturnPath := by
  intro s t hst
  apply unitInterval.symm_bijective.injective
  exact D.trimmedReturnLine.toPath_injective
    (I.levelArc a).endpoint_ne hst

theorem range_trimmedReturnPath_subset
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    range D.trimmedReturnPath ⊆ D.trimmedReturnSet := by
  rw [trimmedReturnPath, Path.symm_range]
  exact D.trimmedReturnLine.range_toPath_subset
    (I.levelArc a).endpoint_ne

/-- The return carrier is contained in the exact un-loop-erased boundary
whose metric estimate was proved at the trimming stage. -/
theorem trimmedReturnSet_subset_trimmedCollarBoundarySet
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    D.trimmedReturnSet ⊆ D.trimmedCollarBoundarySet := by
  rintro x ((hxLeft | hxMiddle) | hxRight)
  · exact Or.inr (by simpa [segment_symm] using hxLeft)
  · exact Or.inl (Or.inr
      (JordanCircle.BrokenLineData.segmentCarrier_subset
        D.trimmedLine.data hxMiddle))
  · exact Or.inl (Or.inl (by simpa [segment_symm] using hxRight))

theorem range_trimmedReturnPath_subset_thickening
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    range D.trimmedReturnPath ⊆
      thickening epsilon (I.levelArc a).curveArcPlane :=
  D.range_trimmedReturnPath_subset.trans
    (D.trimmedReturnSet_subset_trimmedCollarBoundarySet.trans
      D.trimmedCollarBoundarySet_subset_thickening)

/-- Apart from the two boundary endpoints, the entire loop-erased return
lies in the open inside of the original Jordan circle. -/
theorem trimmedReturnSet_subset_insideCrosscutSet
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    D.trimmedReturnSet ⊆
      J.insideCrosscutSet
        (J.curvePoint (I.levelArc a).left)
        (J.curvePoint (I.levelArc a).right) := by
  rintro x ((hxLeft | hxMiddle) | hxRight)
  · have hxHair :
        x ∈ (I.levelLeftHairNear a hepsilon).carrier :=
      (convex_segment
        (J.curvePoint (I.levelArc a).left : Plane)
        (I.levelLeftHairNear a hepsilon).tip).segment_subset
          (left_mem_segment ℝ _ _) D.trimmedLeftPoint_mem hxLeft
    rcases (I.levelLeftHairNear a hepsilon).carrier_subset hxHair with
      hxInside | hxBase
    · exact Or.inl hxInside
    · exact Or.inr (Or.inl (mem_singleton_iff.mp hxBase))
  · exact Or.inl
      (D.trimmedLine_segmentCarrier_subset_controlled hxMiddle).1
  · have hxHair :
        x ∈ (I.levelRightHairNear a hepsilon).carrier :=
      (convex_segment
        (J.curvePoint (I.levelArc a).right : Plane)
        (I.levelRightHairNear a hepsilon).tip).segment_subset
          (left_mem_segment ℝ _ _) D.trimmedRightPoint_mem
          (by simpa [segment_symm] using hxRight)
    rcases (I.levelRightHairNear a hepsilon).carrier_subset hxHair with
      hxInside | hxBase
    · exact Or.inl hxInside
    · exact Or.inr (Or.inr hxBase)

/-- The trimmed three-piece return, behind the stable interface used by all
separator and auxiliary-cell arguments. -/
noncomputable def trimmedInsideReturnArc
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    (I.levelArc a).InsideReturnArc where
  permittedSet := D.trimmedReturnSet
  path := D.trimmedReturnPath
  sourceBrokenLine := D.trimmedReturnLine
  path_injective := D.trimmedReturnPath_injective
  segmentCarrier_eq_range := by
    rw [D.trimmedReturnLine.segmentCarrier_carrierBrokenLine
        (I.levelArc a).endpoint_ne,
      trimmedReturnPath, Path.symm_range]
  range_subset_insideCrosscutSet :=
    D.range_trimmedReturnPath_subset.trans
      D.trimmedReturnSet_subset_insideCrosscutSet

@[simp] theorem trimmedInsideReturnArc_path
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    D.trimmedInsideReturnArc.path = D.trimmedReturnPath := rfl

/-- The one-cell auxiliary Jordan circle bounded by the wild level arc and
the trimmed finite polygonal return. -/
noncomputable def trimmedAuxiliaryJordanCircle
    (D : I.LevelInsideJoinData a epsilon hepsilon) : JordanCircle :=
  D.trimmedInsideReturnArc.auxiliaryJordanCircle

@[simp] theorem carrier_trimmedAuxiliaryJordanCircle
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    D.trimmedAuxiliaryJordanCircle.carrier =
      (I.levelArc a).curveArcPlane ∪ range D.trimmedReturnPath := by
  exact D.trimmedInsideReturnArc.carrier_auxiliaryJordanCircle

/-- The Jordan cell cut off by the trimmed return is genuinely on the inside
side of the original curve. -/
theorem inside_trimmedAuxiliaryJordanCircle_subset
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    D.trimmedAuxiliaryJordanCircle.inside ⊆ J.inside :=
  D.trimmedInsideReturnArc.inside_auxiliaryJordanCircle_subset

/-- The complete boundary of the one-cell auxiliary circle retains the
prescribed metric-neighborhood control. -/
theorem carrier_trimmedAuxiliaryJordanCircle_subset_thickening
    (D : I.LevelInsideJoinData a epsilon hepsilon) :
    D.trimmedAuxiliaryJordanCircle.carrier ⊆
      thickening epsilon (I.levelArc a).curveArcPlane := by
  rw [D.carrier_trimmedAuxiliaryJordanCircle]
  exact union_subset (self_subset_thickening hepsilon _)
    D.range_trimmedReturnPath_subset_thickening

end LevelInsideJoinData
end InitialAngularArcs
end JordanCircle

end Schoenflies
